5","FUEL/PROPULSION SYSTEM",0,0,0,0],[11081533,"2018-03-27","FUEL/PROPULSION SYSTEM",0,0,0,0],[11081035,"2018-03-23","POWER TRAIN",0,0,0,0],[11081116,"2018-03-23","ELECTRICAL SYSTEM,ELECTRONIC STABILITY CONTROL (ESC),ENGINE",0,0,0,0],[11080880,"2018-03-22","POWER TRAIN,ENGINE",0,0,0,0],[11080102,"2018-03-19","EXTERIOR LIGHTING",0,0,0,0],[11078811,"2018-03-12","AIR BAGS,SERVICE BRAKES",1,0,3,0],[11076833,"2018-03-08","UNKNOWN OR OTHER",1,0,0,0],[11076835,"2018-03-08","POWER TRAIN",0,0,0,0],[11076879,"2018-03-08","SEAT BELTS",0,0,0,0],[11076077,"2018-03-03","ELECTRICAL SYSTEM",0,0,0,0],[11075223,"2018-02-27","ELECTRONIC STABILITY CONTROL (ESC)",0,0,0,0],[11073587,"2018-02-19","SERVICE BRAKES",0,0,0,0],[11073327,"2018-02-16","AIR BAGS",1,0,0,0],[11073166,"2018-02-15","POWER TRAIN",0,0,0,0],[11063276,"2018-01-17","SERVICE BRAKES",0,0,0,0],[11060943,"2018-01-06","STRUCTURE",0,0,0,0],[11057692,"2017-12-30","FUEL/PROPULSION SYSTEM",0,0,0,0],[11056171,"2017-12-23","FUEL/PROPULSION SYSTEM",0,0,0,0],[11054895,"2017-12-15","POWER TRAIN",0,0,0,0],[11053645,"2017-12-09","EXTERIOR LIGHTING",0,0,0,0],[11046413,"2017-11-15","VISIBILITY/WIPER",0,0,0,0],[11032088,"2017-10-06","UNKNOWN OR OTHER",0,0,0,0],[11030469,"2017-09-29","POWER TRAIN",1,0,0,0],[11019976,"2017-08-27","SERVICE BRAKES",0,0,0,0],[11002082,"2017-06-29","STEERING,UNKNOWN OR OTHER,ELECTRONIC STABILITY CONTROL (ESC)",0,0,0,0]],"recalls":[{"campaign":"18V576000","received":"2018-08-30","manufacturer":"General Motors LLC","component":"SERVICE BRAKES, HYDRAULIC:FOUNDATION COMPONENTS:DISC:CALIPER","summary":"General Motors LLC (GM) is recalling certain 2018-2019 Chevrolet Equinox, Impala, Cruze, Volt and Bolt EV vehicles, GMC Terrain vehicles, Buick Lacrosse and Regal vehicles, Cadillac XTS and XTS Professional vehicles and 2018 Chevrolet Malibu vehicles. The rear brake caliper pistons may have an insufficient coating causing gas pockets to form, potentially reducing rear brake performance.","consequence":"A reduction of braking performance can increase the risk of a crash.","remedy":"GM will notify owners, and dealers will bleed the vehicle's brake system, free of charge.  The recall began October 11, 2018.  Owners may contact Buick customer service at 1-800-521-7300, Cadillac customer service at 1-800-458-8006, Chevrolet customer service at 1-800-222-1020, or GMC customer service at 1-800-462-8782.  GM's number for this recall is 18279.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":210628,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V576000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":19,"campaign_vehicles":[{"year":"2018","make":"CHEVROLET","model":"EQUINOX"},{"year":"2019","make":"GMC","model":"TERRAIN"},{"year":"2019","make":"BUICK","model":"REGAL"},{"year":"2019","make":"BUICK","model":"LACROSSE"},{"year":"2018","make":"CHEVROLET","model":"BOLT EV"},{"year":"2018","make":"CADILLAC","model":"XTS"},{"year":"2018","make":"CHEVROLET","model":"MALIBU"},{"year":"2018","make":"CHEVROLET","model":"CRUZE"},{"year":"2019","make":"CHEVROLET","model":"IMPALA"},{"year":"2019","make":"CHEVROLET","model":"CRUZE"},{"year":"2019","make":"CHEVROLET","model":"VOLT"},{"year":"2019","make":"CADILLAC","model":"XTS"},{"year":"2019","make":"CHEVROLET","model":"BOLT EV"},{"year":"2019","make":"CHEVROLET","model":"EQUINOX"},{"year":"2018","make":"BUICK","model":"LACROSSE"},{"year":"2018","make":"CHEVROLET","model":"IMPALA"},{"year":"2018","make":"GMC","model":"TERRAIN"},{"year":"2018","make":"CHEVROLET","model":"VOLT"},{"year":"2018","make":"BUICK","model":"REGAL"}],"campaign_vehicles_truncated":false},{"campaign":"18V358000","received":"2018-05-31","manufacturer":"General Motors LLC","component":"FUEL SYSTEM, GASOLINE:DELIVERY:FUEL PUMP","summary":"General Motors LLC (GM) is recalling certain 2015-2018 GMC Canyon, 2016-2017 Buick Envision, 2016-2018 Chevrolet Colorado and Malibu, 2017-2018 GMC Acadia, 2018 Buick LaCrosse, Cadillac ATS, Chevrolet Equinox, and GMC Terrain vehicles.  The high pressure fuel pump may detach from its mounting flange, possibly resulting in the pump damaging the high pressure fuel line.","consequence":"A damaged fuel line can create a fuel leak, increasing the risk of a fire.","remedy":"GM will notify owners, and dealers will replace the high pressure fuel pump, and high pressure fuel pipe, free of charge.  The recall began July 2, 2018.  Owners may contact Buick customer service at 1-800-521-7300, Cadillac customer service at 1-800-458-8006, Chevrolet customer service at 1-800-222-1020, or GMC customer service at 1-800-462-8782.  GM's number for this recall is 18188.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":895,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V358000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":18,"campaign_vehicles":[{"year":"2015","make":"GMC","model":"CANYON"},{"year":"2017","make":"GMC","model":"CANYON"},{"year":"2016","make":"GMC","model":"CANYON"},{"year":"2016","make":"CHEVROLET","model":"MALIBU"},{"year":"2017","make":"CHEVROLET","model":"COLORADO"},{"year":"2018","make":"CHEVROLET","model":"EQUINOX"},{"year":"2017","make":"GMC","model":"ACADIA"},{"year":"2016","make":"CHEVROLET","model":"COLORADO"},{"year":"2017","make":"BUICK","model":"ENVISION"},{"year":"2016","make":"BUICK","model":"ENVISION"},{"year":"2017","make":"CHEVROLET","model":"MALIBU"},{"year":"2018","make":"CHEVROLET","model":"COLORADO"},{"year":"2018","make":"CHEVROLET","model":"MALIBU"},{"year":"2018","make":"GMC","model":"CANYON"},{"year":"2018","make":"BUICK","model":"LACROSSE"},{"year":"2018","make":"GMC","model":"TERRAIN"},{"year":"2018","make":"GMC","model":"ACADIA"},{"year":"2018","make":"CADILLAC","model":"ATS"}],"campaign_vehicles_truncated":false},{"campaign":"18V252000","received":"2018-04-19","manufacturer":"General Motors LLC","component":"VISIBILITY","summary":"General Motors LLC (GM) is recalling certain 2018 Chevrolet Equinox vehicles.  The driver and front passenger door window glass may not be properly tempered.  As such, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard (FMVSS) number 205, \"Glazing Materials.\"","consequence":"If the glass is not tempered properly, and the window is broken, the glass can break into large pieces, increasing the risk of injury.","remedy":"GM will notify owners, and dealers will replace the glass in the front doors, free of charge.  The recall began May 15, 2018.  Owners may contact Chevrolet customer service at 1-800-222-1020.  GM's number for this recall is 18136.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":379,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V252000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2018","make":"CHEVROLET","model":"EQUINOX"}],"campaign_vehicles_truncated":false},{"campaign":"17V516000","received":"2017-08-22","manufacturer":"General Motors LLC","component":"POWER TRAIN:DRIVELINE:DRIVESHAFT","summary":"General Motors LLC (GM) is recalling certain 2018 Chevrolet Equinox and GMC Terrain vehicles and 2017-2018 GMC Acadia  vehicles.  The right front intermediate driveshaft may fracture and separate while driving.","consequence":"If the front right intermediate drive shaft assembly separates while driving, the vehicle will lose propulsion, increasing the risk of a crash.  If the assembly separates while parked on a grade, without the park brake engaged, the vehicle may move unintentionally, increasing the risk of a vehicle roll-away.","remedy":"GM will notify owners, and dealers will replace the right front intermediate drive shaft assembly, free of charge.  The recall began August 25, 2017.  Owners may contact GMC customer service at 1-800-462-8782 or Chevrolet customer service at 1-800-222-1020.  GM's number for this recall is 17329.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":2905,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=17V516000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":4,"campaign_vehicles":[{"year":"2018","make":"CHEVROLET","model":"EQUINOX"},{"year":"2017","make":"GMC","model":"ACADIA"},{"year":"2018","make":"GMC","model":"TERRAIN"},{"year":"2018","make":"GMC","model":"ACADIA"}],"campaign_vehicles_truncated":false},{"campaign":"20V668000","received":"2020-10-29","manufacturer":"General Motors LLC","component":"POWER TRAIN:AUTOMATIC TRANSMISSION","summary":"General Motors LLC (GM) is recalling certain 2018-2019 Chevrolet Cruze and Buick LaCrosse, 2018-2020 Chevrolet Equinox, Chevrolet Traverse and GMC Terrain, 2018 Chevrolet Malibu, 2019-2020 Buick Encore, Buick Enclave, Cadillac XT4, Chevrolet Blazer and GMC Acadia, and 2020 Cadillac XT6 vehicles.  The start/stop accumulator endcap may have missing bolts.","consequence":"Missing bolts on the start-stop accumulator endcap could result in a transmission oil leak and may progress to a loss of propulsion, increasing the risk of a crash.  A transmission fluid leak in the presence of an ignition source may increase the risk of fire.","remedy":"GM will notify owners, and dealers will inspect the start-stop transmission accumulator and replace it if any bolts are missing, free of charge.  The recall began December 15, 2020.  Owners may contact GMC customer service at 1-888-988-7267, Buick Customer service at 1-866-608-8080, Chevrolet customer service at 1-800-222-1020 or Cadillac customer service at 1-800-458-8006.  GM's number for this recall is N202313440.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":194105,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V668000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":25,"campaign_vehicles":[{"year":"2020","make":"CHEVROLET","model":"BLAZER"},{"year":"2020","make":"GMC","model":"ACADIA"},{"year":"2020","make":"CADILLAC","model":"XT6"},{"year":"2019","make":"GMC","model":"TERRAIN"},{"year":"2019","make":"BUICK","model":"LACROSSE"},{"year":"2019","make":"CHEVROLET","model":"EQUINOX"},{"year":"2019","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2019","make":"GMC","model":"ACADIA"},{"year":"2019","make":"CHEVROLET","model":"CRUZE"},{"year":"2019","make":"CHEVROLET","model":"BLAZER"},{"year":"2020","make":"CHEVROLET","model":"EQUINOX"},{"year":"2020","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2020","make":"BUICK","model":"ENCLAVE"},{"year":"2019","make":"BUICK","model":"ENCORE"},{"year":"2020","make":"CADILLAC","model":"XT4"},{"year":"2019","make":"CADILLAC","model":"XT4"},{"year":"2019","make":"BUICK","model":"ENCLAVE"},{"year":"2020","make":"BUICK","model":"ENCORE"},{"year":"2018","make":"CHEVROLET","model":"CRUZE"},{"year":"2018","make":"CHEVROLET","model":"MALIBU"},{"year":"2018","make":"CHEVROLET","model":"EQUINOX"},{"year":"2018","make":"BUICK","model":"LACROSSE"},{"year":"2018","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2018","make":"GMC","model":"TERRAIN"}],"campaign_vehicles_truncated":true}]}

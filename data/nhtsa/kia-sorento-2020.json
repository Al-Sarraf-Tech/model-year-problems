326068,"2020-05-26","POWER TRAIN",0,0,0,0],[11310921,"2020-02-23","POWER TRAIN",0,0,0,0]],"recalls":[{"campaign":"22V703000","received":"2022-09-19","manufacturer":"Kia America, Inc.","component":"TRAILER HITCHES","summary":"Kia America, Inc. (Kia) is recalling certain 2016-2022 Sorento, 2021-2022 Sorento Hybrid (HEV), 2022-2023 Sorento Plug-In Hybrid (PHEV), and 2017-2022 Sportage vehicles equipped with a tow hitch harness installed as original equipment, or purchased as an accessory through a Kia dealership.  Debris and moisture accumulation on the tow hitch harness module printed circuit board (PCB) may cause an electrical short, which can result in a fire.","consequence":"A fire while parked or driving can increase the risk of injury.","remedy":"Owners are advised to park outside and away from structures until the recall repair is complete.  Dealers will inspect the vehicle, and, as necessary, replace the fuse and/or tow hitch harness module, free of charge.  Owner notification letters were mailed August 11, 2023.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC249.","park_it":false,"park_outside":true,"over_the_air":false,"has_potential_units":true,"potential_units":70887,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=22V703000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":18,"campaign_vehicles":[{"year":"2016","make":"KIA","model":"SORENTO"},{"year":"2017","make":"KIA","model":"SPORTAGE"},{"year":"2017","make":"KIA","model":"SORENTO"},{"year":"2021","make":"KIA","model":"SORENTO"},{"year":"2022","make":"KIA","model":"SORENTO PHEV"},{"year":"2022","make":"KIA","model":"SORENTO"},{"year":"2022","make":"KIA","model":"SORENTO HYBRID"},{"year":"2020","make":"KIA","model":"SORENTO"},{"year":"2018","make":"KIA","model":"SORENTO"},{"year":"2022","make":"KIA","model":"SPORTAGE"},{"year":"2021","make":"KIA","model":"SORENTO HYBRID"},{
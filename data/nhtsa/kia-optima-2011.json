vehicles":[{"year":"2013","make":"KIA","model":"SPORTAGE"},{"year":"2012","make":"KIA","model":"SPORTAGE"},{"year":"2013","make":"KIA","model":"SORENTO"},{"year":"2012","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"SPORTAGE"},{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2012","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SORENTO"},{"year":"2015","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SPORTAGE"},{"year":"2015","make":"KIA","model":"SPORTAGE"},{"year":"2015","make":"KIA","model":"SORENTO"},{"year":"2016","make":"KIA","model":"SORENTO"},{"year":"2017","make":"KIA","model":"SPORTAGE"},{"year":"2016","make":"KIA","model":"OPTIMA"},{"year":"2017","make":"KIA","model":"SORENTO"},{"year":"2016","make":"KIA","model":"SPORTAGE"},{"year":"2017","make":"KIA","model":"OPTIMA"},{"year":"2018","make":"KIA","model":"SPORTAGE"}],"campaign_vehicles_truncated":false},{"campaign":"18V363000","received":"2018-06-01","manufacturer":"Kia Motors America","component":"AIR BAGS: AIR BAG/RESTRAINT CONTROL MODULE","summary":"Kia Motors America (Kia) is recalling certain 2010-2013 Kia Forte, Forte Koup, 2011-2013 Kia Optima and 2011-2012 Kia Optima Hybrid and Sedona vehicles.  In the event of a crash, the air bag control unit (ACU) may short circuit, preventing the frontal air bags and seat belt pretensioners from deploying.","consequence":"If the frontal air bags and seat belt pretensioners are disabled, there is an increased risk of injury to the vehicle occupants in the event of a vehicle crash that necessitates deployment of these safety systems.","remedy":"Kia will notify owners.  For model year 2011 Sedona vehicles, Kia will instruct dealers to verify the ACU part number and, if necessary, install an extension wire harness kit between the ACU Connector and the Vehicle Harness Connector. For all other affected vehicles, Kia will instruct dealers to install the extension wire harness kit.  The recall began September 28, 2018.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC165.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":507587,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V363000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":15,"campaign_vehicles":[{"year":"2010","make":"KIA","model":"FORTE"},{"year":"2012","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2011","make":"KIA","model":"FORTE"},{"year":"2012","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"OPTIMA"},{"year":"2012","make":"KIA","model":"SEDONA"},{"year":"2012","make":"KIA","model":"FORTE"},{"year":"2011","make":"KIA","model":"SEDONA"},{"year":"2013","make":"KIA","model":"OPTIMA"},{"year":"2013","make":"KIA","model":"FORTE"},{"year":"2011","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2013","make":"KIA","model":"FORTE KOUP"},{"year":"2012","make":"KIA","model":"FORTE KOUP"},{"year":"2010","make":"KIA","model":"FORTE KOUP"},{"year":"2011","make":"KIA","model":"FORTE KOUP"}],"campaign_vehicles_truncated":false},{"campaign":"17V224000","received":"2017-03-31","manufacturer":"Kia Motors America","component":"ENGINE AND ENGINE COOLING:ENGINE","summary":"Kia Motor Company (Kia) is recalling certain 2011-2014 Optima, 2012-2014 Sorento and 2011-2013 Sportage vehicles.  Machining errors during the engine manufacturing process may cause premature bearing wear within the engine.","consequence":"Bearing wear may result in the engine seizing, increasing the risk of a crash.","remedy":"Kia will notify owners, and dealers will inspect the engine assembly, and replace the engine if necessary, free of charge.  The recall began June 20, 2017.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC147.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":618160,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=17V224000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":10,"campaign_vehicles":[{"year":"2013","make":"KIA","model":"SPORTAGE"},{"year":"2012","make":"KIA","model":"SPORTAGE"},{"year":"2013","make":"KIA","model":"SORENTO"},{"year":"2012","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"SPORTAGE"},{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2012","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SORENTO"}],"campaign_vehicles_truncated":false},{"campaign":"13V114000","received":"2013-04-01","manufacturer":"Kia Motors Corporation","component":"EXTERIOR LIGHTING:BRAKE LIGHTS:SWITCH","summary":"Kia Motors Corporation (Kia) is recalling certain model year 2007-2010 Rondo, model year 2007-2011 Sedona, Sorento and Sportage, model year 2010-2011 Soul, model year 2008-2011 Optima, model year 2010 Forte, model year 2007-2009 Amanti, and model year 2009 Borrego vehicles.  Originally, in April 2013, Kia recalled 623,658 model year 2007-2010 Rondo and Sportage, model year 2007-2011 Sorento, model year 2007 Sedona, model year 2010-2011 Soul, and model year 2011 Optima vehicles.   In September 2013, Kia informed the agency that it was adding an additional 356,719 vehicles to this campaign.  The total number of vehicles being recalled is now 980,377.  In the affected vehicles, the stop lamp switch may malfunction.  A malfunctioning stop lamp switch may cause the brake lights to not illuminate when the brake pedal is depressed or may cause an inability to deactivate the cruise control by depressing the brake pedal.  Additionally, a malfunctioning stop lamp switch may also result in intermittent operation of the push-button start feature, affect the operation of the brake-transmission shift interlock feature preventing the shifter from being moved out of the PARK position and cause the Electronic Stability Control (ESC) malfunction light to illuminate.","consequence":"Failure to illuminate the stop lamps during braking or inability to disengage the cruise control could increase the risk of a crash.  Additionally, when the ignition is in the 'ON' position, the transmission shifter may be able to be moved out of PARK without first applying the brake.  This may lead to unintentional movement of the car which may increase the risk of a crash.","remedy":"Kia will send an interim notification to owners in May 2013.  When parts are available, owners will receive a second notification and dealers will replace the stop lamp switch, free of charge.  Owners may contact Kia at 1-800-333-4542.  Kia's recall campaign number is SC098.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":980377,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=13V114000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":30,"campaign_vehicles":[{"year":"2007","make":"KIA","model":"AMANTI"},{"year":"2007","make":"KIA","model":"SEDONA"},{"year":"2007","make":"KIA","model":"SORENTO"},{"year":"2007","make":"KIA","model":"SPORTAGE"},{"year":"2007","make":"KIA","model":"RONDO"},{"year":"2008","make":"KIA","model":"SEDONA"},{"year":"2008","make":"KIA","model":"OPTIMA"},{"year":"2008","make":"KIA","model":"SORENTO"},{"year":"2008","make":"KIA","model":"AMANTI"},{"year":"2009","make":"KIA","model":"SEDONA"},{"year":"2009","make":"KIA","model":"SORENTO"},{"year":"2009","make":"KIA","model":"SPORTAGE"},{"year":"2009","make":"KIA","model":"BORREGO"},{"year":"2009","make":"KIA","model":"OPTIMA"},{"year":"2008","make":"KIA","model":"SPORTAGE"},{"year":"2008","make":"KIA","model":"RONDO"},{"year":"2009","make":"KIA","model":"AMANTI"},{"year":"2009","make":"KIA","model":"RONDO"},{"year":"2010","make":"KIA","model":"FORTE"},{"year":"2010","make":"KIA","model":"SEDONA"},{"year":"2010","make":"KIA","model":"SOUL"},{"year":"2010","make":"KIA","model":"SPORTAGE"},{"year":"2010","make":"KIA","model":"OPTIMA"},{"year":"2010","make":"KIA","model":"RONDO"}],"campaign_vehicles_truncated":true},{"campaign":"23V652000","received":"2023-09-25","manufacturer":"Kia America, Inc.","component":"SERVICE BRAKES, HYDRAULIC:ANTILOCK/TRACTION CONTROL/ELECTRONIC LIMITED SLIP:CONTROL UNIT/MODULE","summary":"Kia America, Inc. (Kia) is recalling certain 2010-2019 Borrego, 2014-2016 Cadenza, 2010-2013 Forte, Forte Koup, Sportage, 2015-2018 K900, 2011-2015 Optima, 2011-2013 Optima Hybrid, Soul, 2012-2017 Rio, 2011-2014 Sorento, and 2010-2011 Rondo vehicles.  The Hydraulic Electronic Control Unit (HECU) may experience an electrical short, which can result in an engine compartment fire while parked or driving.","consequence":"An engine compartment fire while parked or driving can increase the risk of injury.","remedy":"Owners are advised to park outside and away from structures until the recall repair is complete.  Dealers will replace the HECU fuse, free of charge.  Interim notification letters, notifying owners of the safety risk, were mailed November 14, 2023.  Owner notification letters were mailed March 29, 2024 through June 18, 2024.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC284.","park_it":false,"park_outside":true,"over_the_air":false,"has_potential_units":true,"potential_units":1730192,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V652000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":52,"campaign_vehicles":[{"year":"2013","make":"KIA","model":"BORREGO"},{"year":"2014","make":"KIA","model":"RIO"},{"year":"2018","make":"KIA","model":"BORREGO"},{"year":"2014","make":"KIA","model":"SORENTO"},{"year":"2011","make":"KIA","model":"SPORTAGE"},{"year":"2011","make":"KIA","model":"SOUL"},{"year":"2012","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2011","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"RIO"},{"year":"2017","make":"KIA","model":"BORREGO"},{"year":"2012","make":"KIA","model":"OPTIMA"},{"year":"2012","make":"KIA","model":"RIO"},{"year":"2018","make":"KIA","model":"K900"},{"year":"2013","make":"KIA","model":"FORTE"},{"year":"2014","make":"KIA","model":"BORREGO"},{"year":"2013","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2015","make":"KIA","model":"K900"},{"year":"2014","make":"KIA","model":"CADENZA"},{"year":"2012","make":"KIA","model":"FORTE KOUP"},{"year":"2012","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"FORTE KOUP"},{"year":"2012","make":"KIA","model":"SPORTAGE"},{"year":"2010","make":"KIA","model":"SPORTAGE"},{"year":"2011","make":"KIA","model":"OPTIMA"}],"campaign_vehicles_truncated":true}]}

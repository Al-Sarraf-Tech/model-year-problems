":true,"potential_units":1873,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=10E019000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":40,"campaign_vehicles":[{"year":"2004","make":"INFINITI","model":"QX56"},{"year":"2004","make":"NISSAN","model":"ARMADA"},{"year":"2004","make":"NISSAN","model":"TITAN"},{"year":"2006","make":"NISSAN","model":"TITAN"},{"year":"2005","make":"NISSAN","model":"XTERRA"},{"year":"2006","make":"NISSAN","model":"ARMADA"},{"year":"2005","make":"NISSAN","model":"ARMADA"},{"year":"2005","make":"NISSAN","model":"PATHFINDER"},{"year":"2005","make":"INFINITI","model":"QX56"},{"year":"2006","make":"INFINITI","model":"QX56"},{"year":"2005","make":"NISSAN","model":"FRONTIER"},{"year":"2005","make":"NISSAN","model":"TITAN"},{"year":"2006","make":"NISSAN","model":"FRONTIER"},{"year":"2006","make":"NISSAN","model":"PATHFINDER"},{"year":"2006","make":"NISSAN","model":"XTERRA"},{"year":"2008","make":"NISSAN","model":"TITAN"},{"year":"2008","make":"NISSAN","model":"FRONTIER"},{"year":"2008","make":"NISSAN","model":"ARMADA"},{"year":"2008","make":"NISSAN","model":"PATHFINDER"},{"year":"2008","make":"NISSAN","model":"XTERRA"},{"year":"2008","make":"INFINITI","model":"QX56"},{"year":"2007","make":"NISSAN","model":"ARMADA"},{"year":"2007","make":"NISSAN","model":"XTERRA"},{"year":"2007","make":"NISSAN","model":"PATHFINDER"}],"campaign_vehicles_truncated":true},{"campaign":"10V115000","received":"2010-03-24","manufacturer":"NISSAN NORTH AMERICA, INC.","component":"STEERING:GEAR BOX:SHAFT SECTOR","summary":"NISSAN HAS NOTIFIED NHTSA OF A DEFECT IN CERTAIN MODEL YEAR 2010 FRONTIER, PATHFINDER, AND XTERRA VEHICLES MANUFACTURED FROM FEBRUARY 22, 2010 TO MARCH 13, 2010.  ON SOME OF THE POTENTIALLY AFFECTED VEHICLES, THE FASTENERS SECURING THE PASSENGER FRONT AIR BAG MODULE, AND ALSO THE FASTENERS SECURING THE STEERING SHAFT POSITIONING BRACKET MAY NOT HAVE BEEN TIGHTENED TO THE PROPER TORQUE SPECIFICATION.","consequence":"IN THE EVENT OF A CRASH, THE PASSENGER FRONT AIR BAG DEPLOYMENT TRAJECTORY MIGHT BE AFFECTED.  THE FASTENERS COULD POSSIBLY COME OUT OF THE STEERING COLUMN POSITIONING BRACKET INCREASING THE RISK OF A CRASH.","remedy":"DEALERS WILL INSPECT THE STEERING COLUMN AND THE PASSENGER FRONT AIR BAG FASTENERS AND ANY MISSING FASTENERS WILL BE REPLACED AND ALL LOOSE FASTENERS WILL BE RETIGHTENED TO THE PROPER TORQUE SPECIFICATIONS FREE OF CHARGE.  THE SAFETY RECALL BEGAN ON APRIL 19, 2010.  OWNERS MAY CONTACT NISSAN AT 1-800-647-7261.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":4038,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=10V115000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2010","make":"NISSAN","model":"PATHFINDER"},{"year":"2010","make":"NISSAN","model":"XTERRA"}],"campaign_vehicles_truncated":false},{"campaign":"10V208000","received":"2010-05-14","manufacturer":"NISSAN NORTH AMERICA, INC.","component":"SUSPENSION:FRONT:CONTROL ARM:LOWER ARM","summary":"NISSAN IS RECALLING CERTAIN MODEL YEAR 2010 TITAN, ARMADA, QX56, FRONTIER, XTERRA, AND PATHFINDER VEHICLES MANUFACTURED FROM NOVEMBER 19, 2009 THROUGH MARCH 3, 2010.  THE LOWER CONTROL LINK ASSEMBLY HAS TWO CYLINDRICAL COLLARS FORMING THE INBOARD ATTACHMENT POINTS TO THE CHASSIS.  DUE TO AN IMPROPER WELDING PROCESS SOME COLLARS MAY CONTAIN WELDS THAT DO NOT MEET STRENGTH SPECIFICATIONS.","consequence":"IF THE COLLAR WELD SEPARATES, THE VEHICLE HANDLING WILL DETERIORATE, POSSIBLY RESULTING IN A VEHICLE CRASH.","remedy":"NISSAN WILL NOTIFY OWNERS AND DEALERS WILL REPAIR THE VEHICLES FREE OF CHARGE.  THE SAFETY RECALL BEGAN ON MAY 20, 2010.  OWNERS MAY CONTACT NISSAN AT 1-800-647-7261.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":41649
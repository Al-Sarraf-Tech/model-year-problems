667,"2014-07-02","STEERING",0,0,0,0],[10585944,"2014-05-01","STEERING",0,0,0,0],[10585458,"2014-04-29","STEERING",0,0,0,0],[10584911,"2014-04-25","STEERING,SUSPENSION",0,0,0,0],[10584923,"2014-04-25","ENGINE",0,0,0,0],[10583281,"2014-04-17","STEERING",0,0,0,0],[10582767,"2014-04-17","STEERING",0,0,0,0],[10578641,"2014-04-09","STEERING",0,0,0,0],[10578102,"2014-04-07","STEERING",0,0,0,0],[10574569,"2014-03-26","STEERING",0,0,0,0],[10574629,"2014-03-24","STEERING",0,0,0,0],[10569111,"2014-03-13","STEERING,SUSPENSION,VEHICLE SPEED CONTROL",0,0,0,0],[10568887,"2014-03-12","STEERING",0,0,0,0],[10565194,"2014-02-20","VISIBILITY,STRUCTURE",0,0,0,0],[10564794,"2014-02-18","STEERING",0,0,0,0],[10562581,"2014-02-02","ENGINE",0,0,0,0],[10561751,"2014-01-28","STEERING",0,0,0,0],[10560127,"2014-01-15","ENGINE",0,0,0,0]],"recalls":[{"campaign":"18V907000","received":"2018-12-19","manufacturer":"Kia Motors America","component":"FUEL SYSTEM, GASOLINE:DELIVERY:HOSES, LINES/PIPING, AND FITTINGS","summary":"Kia Motors America (Kia) is recalling certain 2011-2017 Optima, 2012-2017 Sorento and 2011-2018 Sportage vehicles that previously received an engine replacement under recall number 17V-224, warranty, or the Knock Sensor Detection System (KSDS) Product Improvement Campaign.  The high pressure fuel pipe that connects to the fuel pump outlet may have been damaged, misaligned or improperly torqued during the engine replacement procedure, possibly causing a fuel leak.","consequence":"A fuel leak in the presence of an ignition source can increase the risk of a fire.","remedy":"Kia has notified owners, and dealers will inspect and replace the fuel pipe, as necessary, free of charge.  The recall began January 17, 2019.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC172.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":71653,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V907000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":21,"campaign_vehicles":[{"year":"2013","make":"KIA","model":"SPORTAGE"},{"year":"2012","make":"KIA","model":"SPORTAGE"},{"year":"2013","make":"KIA","model":"SORENTO"},{"year":"2012","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"SPORTAGE"},{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2012","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SORENTO"},{"year":"2015","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SPORTAGE"},{"year":"2015","make":"KIA","model":"SPORTAGE"},{"year":"2015","make":"KIA","model":"SORENTO"},{"year":"2016","make":"KIA","model":"SORENTO"},{"year":"2017","make":"KIA","model":"SPORTAGE"},{"year":"2016","make":"KIA","model":"OPTIMA"},{"year":"2017","make":"KIA","model":"SORENTO"},{"year":"2016","make":"KIA","model":"SPORTAGE"},{"year":"2017","make":"KIA","model":"OPTIMA"},{"year":"2018","make":"KIA","model":"SPORTAGE"}],"campaign_vehicles_truncated":false},{"campaign":"20V100000","received":"2020-02-21","manufacturer":"Kia Motors America","component":"FUEL SYSTEM, GASOLINE:DELIVERY:HOSES, LINES/PIPING, AND FITTINGS","summary":"Kia Motors America (Kia) is recalling certain 2013-2014 Optima vehicles equipped with 2.4L Gasoline Direct Injection (GDI) or 2.0L GDI Turbo engines.  The low pressure fuel hose may deteriorate and crack over time due to heat generated within the engine compartment.","consequence":"If the fuel hose cracks, a fuel leak can occur, increasing the risk of a fire.","remedy":"Kia will notify Owners, and Dealers will inspect the low pressure fuel hose for damage or leaking, replacing it as necessary.  If no damage or leaking is found, a heat-protective tape will be installed.  Repairs will be performed free of charge.  The recall began June 12, 2020.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC187.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":141774,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V100000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2013","make":"KIA","model":"OPTIMA"}],"campaign_vehicles_truncated":false},{"campaign":"20V519000","received":"2020-08-27","manufacturer":"Kia Motors America","component":"SERVICE BRAKES, HYDRAULIC:ANTILOCK/TRACTION CONTROL/ELECTRONIC LIMITED SLIP:CONTROL UNIT/MODULE","summary":"Kia Motors America (Kia) is recalling certain 2013-2015 Optima and 2014-2015 Sorento vehicles.  Brake fluid may leak inside the Hydraulic Electronic Control Unit (HECU), possibly resulting in an electrical short.","consequence":"If the HECU short circuits, there is an increased risk of an engine compartment fire.","remedy":"Kia will notify owners, and dealers will inspect the HECU for leaking brake fluid and replace the HECU if necessary, free of charge. Owners are advised to park outside and away from other vehicles and structures until the recall repair is completed.  The recall began October 20, 2020.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC197.","park_it":false,"park_outside":true,"over_the_air":false,"has_potential_units":true,"potential_units":440370,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V519000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":5,"campaign_vehicles":[{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2013","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SORENTO"},{"year":"2015","make":"KIA","model":"OPTIMA"},{"year":"2015","make":"KIA","model":"SORENTO"}],"campaign_vehicles_truncated":false},{"campaign":"21V331000","received":"2021-05-10","manufacturer":"Kia Motors America","component":"SERVICE BRAKES, HYDRAULIC:ANTILOCK/TRACTION CONTROL/ELECTRONIC LIMITED SLIP:CONTROL UNIT/MODULE","summary":"Kia Motors America (Kia) is recalling certain 2013-2015 Optima and 2014-2015 Sorento vehicles previously recalled under recall 20V-519.  Brake fluid may leak inside the Hydraulic Electronic Control Unit (HECU), possibly resulting in an electrical short.","consequence":"An electrical short in the HECU increases the risk of a fire while parked or driving.","remedy":"Owners are advised to park outside and away from other vehicles and structures until the recall repair is completed.  Dealers will install a new multi-fuse, and inspect the HECU for leaks, replacing the HECU if necessary, free of charge.  Owner notification letters were mailed on July 2, 2021.  This recall supersedes previous NHTSA recall number 20V-519.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC212.","park_it":false,"park_outside":true,"over_the_air":false,"has_potential_units":true,"potential_units":440370,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=21V331000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":5,"campaign_vehicles":[{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2013","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SORENTO"},{"year":"2015","make":"KIA","model":"OPTIMA"},{"year":"2015","make":"KIA","model":"SORENTO"}],"campaign_vehicles_truncated":false},{"campaign":"17V224000","received":"2017-03-31","manufacturer":"Kia Motors America","component":"ENGINE AND ENGINE COOLING:ENGINE","summary":"Kia Motor Company (Kia) is recalling certain 2011-2014 Optima, 2012-2014 Sorento and 2011-2013 Sportage vehicles.  Machining errors during the engine manufacturing process may cause premature bearing wear within the engine.","consequence":"Bearing wear may result in the engine seizing, increasing the risk of a crash.","remedy":"Kia will notify owners, and dealers will inspect the engine assembly, and replace the engine if necessary, free of charge.  The recall began June 20, 2017.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC147.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":618160,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=17V224000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":10,"campaign_vehicles":[{"year":"2013","make":"KIA","model":"SPORTAGE"},{"year":"2012","make":"KIA","model":"SPORTAGE"},{"year":"2013","make":"KIA","model":"SORENTO"},{"year":"2012","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"OPTIMA"},{"year":"2011","make":"KIA","model":"SPORTAGE"},{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2012","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"OPTIMA"},{"year":"2014","make":"KIA","model":"SORENTO"}],"campaign_vehicles_truncated":false},{"campaign":"22V093000","received":"2022-02-17","manufacturer":"Kia Motors America","component":"FUEL SYSTEM, GASOLINE:DELIVERY:HOSES, LINES/PIPING, AND FITTINGS","summary":"Kia Motors America (Kia) is recalling certain 2013-2014 Optima vehicles that were previously repaired under NHTSA recall number 20V-100.  The low pressure fuel hose may be damaged, or missing heat-protective tape, which can result in a fuel leak.","consequence":"A fuel leak can increase the risk of a fire.","remedy":"Dealers will replace the low pressure fuel hose, free of charge. Owner notification letters were mailed August 2, 2022.  Owners may contact Kia customer service at 1-800-33-4542.  Kia's number for this recall is SC228.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":72848,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=22V093000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2014","make":"KIA","model":"OPTIMA"},{"year":"2013","make":"KIA","model":"OPTIMA"}],"campaign_vehicles_truncated":false},{"campaign":"23V652000","received":"2023-09-25","manufacturer":"Kia America, Inc.","component":"SERVICE BRAKES, HYDRAULIC:ANTILOCK/TRACTION CONTROL/ELECTRONIC LIMITED SLIP:CONTROL UNIT/MODULE","summary":"Kia America, Inc. (Kia) is recalling certain 2010-2019 Borrego, 2014-2016 Cadenza, 2010-2013 Forte, Forte Koup, Sportage, 2015-2018 K900, 2011-2015 Optima, 2011-2013 Optima Hybrid, Soul, 2012-2017 Rio, 2011-2014 Sorento, and 2010-2011 Rondo vehicles.  The Hydraulic Electronic Control Unit (HECU) may experience an electrical short, which can result in an engine compartment fire while parked or driving.","consequence":"An engine compartment fire while parked or driving can increase the risk of injury.","remedy":"Owners are advised to park outside and away from structures until the recall repair is complete.  Dealers will replace the HECU fuse, free of charge.  Interim notification letters, notifying owners of the safety risk, were mailed November 14, 2023.  Owner notification letters were mailed March 29, 2024 through June 18, 2024.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC284.","park_it":false,"park_outside":true,"over_the_air":false,"has_potential_units":true,"potential_units":1730192,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V652000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":52,"campaign_vehicles":[{"year":"2013","make":"KIA","model":"BORREGO"},{"year":"2014","make":"KIA","model":"RIO"},{"year":"2018","make":"KIA","model":"BORREGO"},{"year":"2014","make":"KIA","model":"SORENTO"},{"year":"2011","make":"KIA","model":"SPORTAGE"},{"year":"2011","make":"KIA","model":"SOUL"},{"year":"2012","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2011","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"RIO"},{"year":"2017","make":"KIA","model":"BORREGO"},{"year":"2012","make":"KIA","model":"OPTIMA"},{"year":"2012","make":"KIA","model":"RIO"},{"year":"2018","make":"KIA","model":"K900"},{"year":"2013","make":"KIA","model":"FORTE"},{"year":"2014","make":"KIA","model":"BORREGO"},{"year":"2013","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2015","make":"KIA","model":"K900"},{"year":"2014","make":"KIA","model":"CADENZA"},{"year":"2012","make":"KIA","model":"FORTE KOUP"},{"year":"2012","make":"KIA","model":"SORENTO"},{"year":"2013","make":"KIA","model":"FORTE KOUP"},{"year":"2012","make":"KIA","model":"SPORTAGE"},{"year":"2010","make":"KIA","model":"SPORTAGE"},{"year":"2011","make":"KIA","model":"OPTIMA"}],"campaign_vehicles_truncated":true}]}

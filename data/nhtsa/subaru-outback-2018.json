ROPULSION SYSTEM",0,0,0,0],[11081260,"2018-03-26","STRUCTURE",0,0,0,0],[11074670,"2018-02-24","UNKNOWN OR OTHER,VISIBILITY/WIPER",0,0,0,0],[11073988,"2018-02-21","ELECTRICAL SYSTEM",0,0,0,0],[11071609,"2018-02-07","STEERING",0,0,0,0],[11065467,"2018-01-27","UNKNOWN OR OTHER",0,0,0,0],[11064339,"2018-01-23","VISIBILITY/WIPER",0,0,0,0],[11063173,"2018-01-16","STEERING,LANE DEPARTURE",0,0,0,0],[11062512,"2018-01-12","VISIBILITY/WIPER",0,0,0,0],[11061559,"2018-01-10","UNKNOWN OR OTHER",0,0,0,0],[11055701,"2017-12-20","STEERING,SERVICE BRAKES",0,0,0,0],[11045969,"2017-11-14","EXTERIOR LIGHTING",0,0,0,0],[11044153,"2017-11-07","ELECTRICAL SYSTEM",0,0,0,0],[11043616,"2017-11-06","ELECTRICAL SYSTEM",0,0,0,0],[11041865,"2017-10-31","ELECTRICAL SYSTEM",0,0,0,0],[11016407,"2017-08-20","VISIBILITY/WIPER",0,0,0,0]],"recalls":[{"campaign":"18V935000","received":"2018-12-31","manufacturer":"Subaru of America, Inc.","component":"VISIBILITY:REARVIEW MIRRORS/DEVICES","summary":"Subaru of America, Inc. (Subaru) is recalling certain 2018 Legacy, Outback, and BRZ vehicles.  In the affected vehicles, a software issue may cause the audio display system to not initialize, resulting in the camera display remaining blank.  If this occurs, the rearview image will not display while backing up the vehicle.  As a result, the vehicles fail to comply with requirements of Federal Motor Vehicle Safety (FMVSS) number 111, \"Rearview Mirrors.\"","consequence":"Failure to display the rearview image while backing up increases the risk of crash.","remedy":"Subaru has notified owners, and dealers will reprogram the audio system display software, free of charge.  The recall began on February 5, 2019.  Owners may contact Subaru customer service at 1-844-373-6614.  Subaru's number for this recall is WTZ-85.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":71190,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V935000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":3,"campaign_vehicles":[{"year":"2018","make":"SUBARU","model":"OUTBACK"},{"year":"2018","make":"SUBARU","model":"LEGACY"},{"year":"2018","make":"SUBARU","model":"BRZ"}],"campaign_vehicles_truncated":false},{"campaign":"18V773000","received":"2018-11-01","manufacturer":"Subaru of America, Inc.","component":"ELECTRICAL SYSTEM:SOFTWARE","summary":"Subaru of America, Inc. (Subaru) is recalling certain 2018 Subaru Legacy and Outback vehicles.  Due to a software error, the low fuel warning light may not illuminate at the intended remaining fuel level and the miles-to-empty display may incorrectly indicate a positive number despite the tank being empty.","consequence":"The inaccurate fuel display may cause a driver to unexpectedly run out of fuel and the vehicle to stall, increasing the risk of a crash.","remedy":"Subaru will notify owners, and dealers will reprogram the combination meter software, free of charge.  The recall began February 20, 2019.  Owners may contact Subaru customer service at 1-844-373-6614.  Subaru's number for this recall is WTW-82.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":228648,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V773000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2018","make":"SUBARU","model":"OUTBACK"},{"year":"2018","make":"SUBARU","model":"LEGACY"}],"campaign_vehicles_truncated":false},{"campaign":"21V587000","received":"2021-07-29","manufacturer":"Subaru of America, Inc.","component":"FUEL SYSTEM, GASOLINE:DELIVERY:FUEL PUMP","summary":"Subaru of America, Inc. (Subaru) is recalling certain 2019-2020 Ascent, 2018 Forester, 2018-2020 Impreza, Legacy, Outback, 2018-2019 BRZ, WRX, and Toyota 86 vehicles.  The low-pressure fuel pump inside the fuel tank may fail.","consequence":"Fuel pump failure can cause an engine stall while driving, increasing the risk of a crash.","remedy":"Dealers will replace the low-pressure fuel pump, free of charge.  Owner notification letters were mailed September 24, 2021.  Subaru and Toyota owners may call customer service at 1-844-373-6614.  Subaru's number for this recall is WRG-21.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":175968,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=21V587000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":18,"campaign_vehicles":[{"year":"2020","make":"SUBARU","model":"IMPREZA"},{"year":"2018","make":"TOYOTA","model":"86"},{"year":"2019","make":"SUBARU","model":"ASCENT"},{"year":"2018","make":"SUBARU","model":"OUTBACK"},{"year":"2019","make":"SUBARU","model":"LEGACY"},{"year":"2019","make":"SUBARU","model":"IMPREZA"},{"year":"2019","make":"TOYOTA","model":"86"},{"year":"2019","make":"SUBARU","model":"BRZ"},{"year":"2020","make":"SUBARU","model":"ASCENT"},{"year":"2020","make":"SUBARU","model":"LEGACY"},{"year":"2019","make":"SUBARU","model":"WRX"},{"year":"2019","make":"SUBARU","model":"OUTBACK"},{"year":"2020","make":"SUBARU","model":"OUTBACK"},{"year":"2018","make":"SUBARU","model":"FORESTER"},{"year":"2018","make":"SUBARU","model":"LEGACY"},{"year":"2018","make":"SUBARU","model":"IMPREZA"},{"year":"2018","make":"SUBARU","model":"BRZ"},{"year":"2018","make":"SUBARU","model":"WRX"}],"campaign_vehicles_truncated":false}]}

 began December 15, 2020.  Owners may contact GMC customer service at 1-888-988-7267, Buick Customer service at 1-866-608-8080, Chevrolet customer service at 1-800-222-1020 or Cadillac customer service at 1-800-458-8006.  GM's number for this recall is N202313440.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":194105,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V668000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":25,"campaign_vehicles":[{"year":"2020","make":"CHEVROLET","model":"BLAZER"},{"year":"2020","make":"GMC","model":"ACADIA"},{"year":"2020","make":"CADILLAC","model":"XT6"},{"year":"2019","make":"GMC","model":"TERRAIN"},{"year":"2019","make":"BUICK","model":"LACROSSE"},{"year":"2019","make":"CHEVROLET","model":"EQUINOX"},{"year":"2019","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2019","make":"GMC","model":"ACADIA"},{"year":"2019","make":"CHEVROLET","model":"CRUZE"},{"year":"2019","make":"CHEVROLET","model":"BLAZER"},{"year":"2020","make":"CHEVROLET","model":"EQUINOX"},{"year":"2020","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2020","make":"BUICK","model":"ENCLAVE"},{"year":"2019","make":"BUICK","model":"ENCORE"},{"year":"2020","make":"CADILLAC","model":"XT4"},{"year":"2019","make":"CADILLAC","model":"XT4"},{"year":"2019","make":"BUICK","model":"ENCLAVE"},{"year":"2020","make":"BUICK","model":"ENCORE"},{"year":"2018","make":"CHEVROLET","model":"CRUZE"},{"year":"2018","make":"CHEVROLET","model":"MALIBU"},{"year":"2018","make":"CHEVROLET","model":"EQUINOX"},{"year":"2018","make":"BUICK","model":"LACROSSE"},{"year":"2018","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2018","make":"GMC","model":"TERRAIN"}],"campaign_vehicles_truncated":true},{"campaign":"21V246000","received":"2021-04-08","manufacturer":"General Motors, LLC","component":"AIR BAGS:CRITICAL FASTENERS","summary":"General Motors, LLC (GM) is recalling certain 2010-2015, 2017 Buick Enclave, 2010-2019 Chevrolet Traverse, and 2011-2016 GMC Acadia vehicles.  The side curtain air bags may not be properly attached.","consequence":"Unsecured side curtain air bags may not perform as intended, increasing the risk of injury.","remedy":"GM will notify owners, and dealers will inspect and, if necessary, realign or replace the weld nuts, free of charge.  Owner notification letters were mailed on May 24, 2021.  Owners may contact Buick customer service at 1-800-521-7300, Chevrolet customer service at 1-800-222-1020, and GMC customer service at 1-800-462-8782.  GM's number for this recall is N202321200.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":108,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=21V246000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":23,"campaign_vehicles":[{"year":"2010","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2010","make":"BUICK","model":"ENCLAVE"},{"year":"2011","make":"BUICK","model":"ENCLAVE"},{"year":"2012","make":"BUICK","model":"ENCLAVE"},{"year":"2011","make":"GMC","model":"ACADIA"},{"year":"2011","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2014","make":"BUICK","model":"ENCLAVE"},{"year":"2015","make":"BUICK","model":"ENCLAVE"},{"year":"2017","make":"BUICK","model":"ENCLAVE"},{"year":"2019","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2014","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2014","make":"GMC","model":"ACADIA"},{"year":"2016","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2016","make":"GMC","model":"ACADIA"},{"year":"2017","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2015","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2015","make":"GMC","model":"ACADIA"},{"year":"2013","make":"GMC","model":"ACADIA"},{"year":"2013","make":"BUICK","model":"ENCLAVE"},{"year":"2013","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2012","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2012","make":"GMC","model":"ACADIA"},{"year":"2018","make":"CHEVROLET","model":"TRAVERSE"}],"campaign_vehicles_truncated":false},{"campaign":"18V774000","received":"2018-11-01","manufacturer":"General Motors LLC","component":"AIR BAGS","summary":"General Motors LLC (GM) is recalling certain 2019 Buick Encore, Chevrolet Spark, Traverse, and Trax vehicles.  The Sensing Diagnostic Module (SDM) on these vehicle may not have been turned off of \"manufacturing mode,\" preventing the air bags from deploying in the event of a crash.","consequence":"If the air bags do not deploy in the event of a crash, it can increase the risk of injury.","remedy":"GM will notify owners, and dealers will reprogram the SDM module to the correct mode, free of charge.  The recall began November 6, 2018.  Owners may contact Buick customer service at 1-800-521-7300 and Chevrolet customer service at 1-800-222-1020.  GM's number for this recall is 18365.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":12,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V774000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":4,"campaign_vehicles":[{"year":"2019","make":"CHEVROLET","model":"TRAX"},{"year":"2019","make":"CHEVROLET","model":"SPARK"},{"year":"2019","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2019","make":"BUICK","model":"ENCORE"}],"campaign_vehicles_truncated":false}]}

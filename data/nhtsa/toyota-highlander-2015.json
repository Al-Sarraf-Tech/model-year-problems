ue,"potential_units":8202,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18E107000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2014","make":"TOYOTA","model":"HIGHLANDER"},{"year":"2015","make":"TOYOTA","model":"HIGHLANDER"},{"year":"2016","make":"TOYOTA","model":"HIGHLANDER"},{"year":"9999","make":"WANDA","model":"REPLACEMENT WINDSHIELD"},{"year":"2017","make":"TOYOTA","model":"HIGHLANDER"},{"year":"2018","make":"TOYOTA","model":"HIGHLANDER"}],"campaign_vehicles_truncated":false},{"campaign":"15V144000","received":"2015-03-13","manufacturer":"Toyota Motor Engineering & Manufacturing","component":"STEERING:ELECTRIC POWER ASSIST SYSTEM","summary":"Toyota Motor Engineering & Manufacturing (Toyota) is recalling certain model year 2015 Camry, Camry Hybrid, Highlander, and Highlander Hybrid, and 2014-2015 Rav4 vehicles.  A component of the electric power steering (EPS) electronic control unit (ECU) may have been damaged during the manufacturing process.  Over time, this damage may result in failure of the electric power steering system.","consequence":"An unexpected loss of power steering increases the risk of a crash.","remedy":"Toyota will notify owners, and dealers will inspect the serial number of the EPS ECU or steering column assembly.   If the number is within the affected range, the EPS ECU will be replaced, free of charge.  The recall began on May 7, 2015.  Owners may contact Toyota customer service at 1-800-331-4331.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":110085,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=15V144000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":4,"campaign_vehicles":[{"year":"2014","make":"TOYOTA","model":"RAV4"},{"year":"2015","make":"TOYOTA","model":"RAV4"},{"year":
"2020-10-10","WHEELS",0,0,0,0],[11363041,"2020-10-06","ELECTRICAL SYSTEM,VISIBILITY/WIPER",0,0,0,0],[11361895,"2020-09-29","POWER TRAIN,ENGINE",0,0,0,0],[11354375,"2020-09-11","POWER TRAIN",0,0,0,0],[11338001,"2020-07-07","VISIBILITY,UNKNOWN OR OTHER",0,0,0,0],[11331879,"2020-07-01","UNKNOWN OR OTHER",0,0,0,0]],"recalls":[{"campaign":"20V550000","received":"2020-09-10","manufacturer":"Ford Motor Company","component":"POWER TRAIN:AUTOMATIC TRANSMISSION","summary":"Ford Motor Company (Ford) is recalling certain 2019-2020 Edge, Transit Connect and Lincoln MKX and 2020 Escape and Lincoln Corsair vehicles.  The start/stop accumulator endcap may have missing or loose bolts.","consequence":"Missing or loose bolts on the start stop accumulator endcap could result in a transmission fluid leak and may progress to a loss of transmission function.  A transmission fluid leak in the presence of an ignition source may increase the risk of fire.","remedy":"Ford will notify owners, and dealers will replace the start/stop accumulator, free of charge.  The recall began September 23, 2020.  Owners may contact Ford customer service at 1-866-436-7332.  Ford's number for this recall is 20S49.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":97,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V550000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":8,"campaign_vehicles":[{"year":"2020","make":"FORD","model":"TRANSIT CONNECT"},{"year":"2019","make":"FORD","model":"EDGE"},{"year":"2020","make":"FORD","model":"ESCAPE"},{"year":"2020","make":"LINCOLN","model":"CORSAIR"},{"year":"2020","make":"FORD","model":"EDGE"},{"year":"2019","make":"FORD","model":"TRANSIT CONNECT"},{"year":"2020","make":"LINCOLN","model":"NAUTILUS"},{"year":"2019","make":"LINCOLN","model":"NAUTILUS"}],"campaign_vehicles_truncated":false},{"campaign":"20V575000","received":"2020-09-23","manufacturer":"Ford Motor Company","component":"BACK OVER PREVENTION: SENSING SYSTEM: CAMERA","summary":"Ford Motor Company (Ford) is recalling certain 2020 Ford F-150, F-250, F-350, F-450, F-550, Explorer, Mustang, Transit, Expedition, Escape, Ranger and Edge, and Lincoln Nautilus and Corsair vehicles.  Due to a poor electrical connection, the rearview camera may intermittently display a blank or distorted image.  As such, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard (FMVSS) number 111, \"Rear Visibility.\"","consequence":"Reduced rearward visibility can increase the risk of a crash.","remedy":"Ford will notify owners, and dealers will replace the rearview camera, free of charge.  The recall began November 17, 2020.  Remedy became available on February 1, 2021.  Owner notification letters were mailed on February 1, 2021.  Owners may contact Ford customer service at 1-866-436-7332.  Ford's number for this recall is 20C19.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":620246,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V575000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":14,"campaign_vehicles":[{"year":"2020","make":"FORD","model":"F-150"},{"year":"2020","make":"FORD","model":"EXPEDITION"},{"year":"2020","make":"FORD","model":"RANGER"},{"year":"2020","make":"FORD","model":"TRANSIT"},{"year":"2020","make":"FORD","model":"F-550 SD"},{"year":"2020","make":"FORD","model":"F-250 SD"},{"year":"2020","make":"FORD","model":"F-350 SD"},{"year":"2020","make":"FORD","model":"F-450 SD"},{"year":"2020","make":"FORD","model":"ESCAPE"},{"year":"2020","make":"FORD","model":"EXPLORER"},{"year":"2020","make":"LINCOLN","model":"CORSAIR"},{"year":"2020","make":"FORD","model":"MUSTANG"},{"year":"2020","make":"FORD","model":"EDGE"},{"year":"2020","make":"LINCOLN","model":"NAUTILUS"}],"campaign_vehicles_truncated":false},{"campaign":"21V011000","received":"2021-01-15","manufacturer":"Ford Motor Company","component":"POWER TRAIN:DRIVELINE:DRIVESHAFT","summary":"Ford Motor Company (Ford) is recalling certain 2020-2021 Edge, 2020 Lincoln Nautilus and Ford Escape and 2021 Lincoln Corsair and Ford Bronco Sport vehicles.  An inadequate amount of lubricant in the rear drive unit may cause seizure of the rear drive axle.","consequence":"If the rear drive unit seizes, there may be a loss of drive and/or a loss of vehicle control, increasing the risk of a crash.","remedy":"Ford will notify owners, and dealers will check the rear drive unit lubricant level.  Axles found to have lubricant at the minimum level will be filled to the full level.  Axles found to be below the minimum lubricant fill level will be replaced, free of charge.  This recall began March 12, 2021.  Owners may contact Ford customer service at 1-866-436-7332.  Ford's number for this recall is 21S02.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":147,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=21V011000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2020","make":"FORD","model":"ESCAPE"},{"year":"2020","make":"FORD","model":"EDGE"},{"year":"2020","make":"LINCOLN","model":"NAUTILUS"},{"year":"2021","make":"LINCOLN","model":"CORSAIR"},{"year":"2021","make":"FORD","model":"EDGE"},{"year":"2021","make":"FORD","model":"BRONCO SPORT"}],"campaign_vehicles_truncated":false},{"campaign":"25V442000","received":"2025-06-27","manufacturer":"Ford Motor Company","component":"BACK OVER PREVENTION:SOFTWARE","summary":"Ford Motor Company (Ford) is recalling certain 2018-2022 Transit Connect, 2019-2020 MKZ, MKX,  Edge, Continental, F-150, Nautilus, Fusion, 2019-2023 Ranger, Mustang, 2020-2021 EcoSport, Expedition, Navigator, 2020-2022 Escape, F-250 SD, Corsair, 2020-2023 Aviator, Transit, 2020-2024 Explorer, 2021-2024 Bronco Sport, and 2022-2024 Maverick vehicles. A software error may cause the rearview camera to display a blank image, or the image may remain on the display after the backing event has ended.","consequence":"A rearview camera that displays a blank image can reduce the driver's view behind the vehicle. A rearview image that continues to be displayed after the vehicle is shifted out of reverse may distract the driver. Both of these situations can increase the risk of a crash.","remedy":"Dealers will update the rearview camera software, free of charge. Owner notification letters were mailed September 4, 2025. Owners may contact Ford customer service at 1-866-436-7332. Ford's number for this recall is 25S72.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":200237,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=25V442000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":64,"campaign_vehicles":[{"year":"2018","make":"FORD","model":"TRANSIT CONNECT"},{"year":"2019","make":"FORD","model":"TRANSIT CONNECT"},{"year":"2020","make":"FORD","model":"TRANSIT CONNECT"},{"year":"2019","make":"FORD","model":"EDGE"},{"year":"2019","make":"FORD","model":"FUSION"},{"year":"2019","make":"FORD","model":"MUSTANG"},{"year":"2019","make":"LINCOLN","model":"MKZ"},{"year":"2019","make":"FORD","model":"F-150"},{"year":"2019","make":"FORD","model":"RANGER"},{"year":"2019","make":"LINCOLN","model":"CONTINENTAL"},{"year":"2020","make":"FORD","model":"ESCAPE"},{"year":"2020","make":"FORD","model":"EXPLORER"},{"year":"2020","make":"LINCOLN","model":"AVIATOR"},{"year":"2020","make":"FORD","model":"F-150"},{"year":"2020","make":"FORD","model":"EXPEDITION"},{"year":"2020","make":"LINCOLN","model":"NAVIGATOR"},{"year":"2020","make":"FORD","model":"F-250 SD"},{"year":"2020","make":"FORD","model":"EDGE"},{"year":"2020","make":"LINCOLN","model":"CORSAIR"},{"year":"2020","make":"FORD","model":"FUSION"},{"year":"2020","make":"FORD","model":"MUSTANG"},{"year":"2020","make":"LINCOLN","model":"MKZ"},{"year":"2020","make":"FORD","model":"ECOSPORT"},{"year":"2020","make":"FORD","model":"TRANSIT"}],"campaign_vehicles_truncated":true}]}

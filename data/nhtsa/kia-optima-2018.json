tside":false,"over_the_air":false,"has_potential_units":true,"potential_units":1710,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V161000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2017","make":"KIA","model":"OPTIMA"},{"year":"2018","make":"KIA","model":"OPTIMA"}],"campaign_vehicles_truncated":false},{"campaign":"23V594000","received":"2023-08-24","manufacturer":"Kia America, Inc.","component":"LATCHES/LOCKS/LINKAGES:TRUNK LID:LATCH","summary":"Kia America, Inc. (Kia) is recalling certain 2016-2017 Rio, 2016-2018 Optima, 2017-2018 Optima Hybrid and Optima Plug-in Hybrid vehicles.  The trunk latch base may crack, preventing the opening of the trunk from the inside.  As such, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard number 401, \"Internal Trunk Release.\"","consequence":"A person inside the trunk compartment may become trapped, increasing their risk of injury.","remedy":"Dealers will replace the trunk latch base subassembly, free of charge.  Owner notification letters were mailed October 19, 2023.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC278.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":319436,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V594000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":9,"campaign_vehicles":[{"year":"2016","make":"KIA","model":"OPTIMA"},{"year":"2016","make":"KIA","model":"RIO"},{"year":"2017","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2018","make":"KIA","model":"OPTIMA HYBRID"},{"year":"2017","make":"KIA","model":"OPTIMA PHEV"},{"year":"2017","make":"KIA","model":"OPTIMA"},{"year":"2018","make":"KIA","model":"OPTIMA"},{"year":"2018","make":"KIA","model":"OPTIMA PHEV"},{"year":"2017","make":"KIA","model":"RIO"}],"campaign_vehicles_truncated":false}]}

 RECALL BEGAN ON SEPTEMBER 16, 2010.  OWNERS MAY CONTACT GARMIN DIRECTLY AT 1-866-957-1981 OR NISSAN AT 1-800-647-7261.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":7948,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=10V401000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":21,"campaign_vehicles":[{"year":"2008","make":"NISSAN","model":"FRONTIER"},{"year":"2008","make":"NISSAN","model":"PATHFINDER"},{"year":"2008","make":"NISSAN","model":"XTERRA"},{"year":"2008","make":"NISSAN","model":"ALTIMA"},{"year":"2008","make":"NISSAN","model":"SENTRA"},{"year":"2008","make":"NISSAN","model":"VERSA"},{"year":"2009","make":"NISSAN","model":"XTERRA"},{"year":"2009","make":"NISSAN","model":"PATHFINDER"},{"year":"2009","make":"NISSAN","model":"ROGUE"},{"year":"2009","make":"NISSAN","model":"FRONTIER"},{"year":"2009","make":"NISSAN","model":"ALTIMA"},{"year":"2009","make":"NISSAN","model":"SENTRA"},{"year":"2008","make":"NISSAN","model":"ROGUE"},{"year":"2010","make":"NISSAN","model":"PATHFINDER"},{"year":"2010","make":"NISSAN","model":"ROGUE"},{"year":"2009","make":"NISSAN","model":"VERSA"},{"year":"2010","make":"NISSAN","model":"XTERRA"},{"year":"2010","make":"NISSAN","model":"ALTIMA"},{"year":"2010","make":"NISSAN","model":"SENTRA"},{"year":"2010","make":"NISSAN","model":"FRONTIER"},{"year":"2010","make":"NISSAN","model":"VERSA"}],"campaign_vehicles_truncated":false}]}

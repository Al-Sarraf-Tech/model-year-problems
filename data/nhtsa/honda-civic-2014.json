_units":true,"potential_units":9816,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=14V109000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2014","make":"HONDA","model":"CIVIC"}],"campaign_vehicles_truncated":false}]}

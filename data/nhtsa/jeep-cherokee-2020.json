11315859,"2020-03-03","STRUCTURE",0,0,0,0],[11312125,"2020-02-28","POWER TRAIN",0,0,0,0],[11307842,"2020-02-08","ENGINE",0,0,0,0],[11277328,"2019-10-31","UNKNOWN OR OTHER,FUEL/PROPULSION SYSTEM",0,0,0,0]],"recalls":[{"campaign":"20V191000","received":"2020-09-10","manufacturer":"Chrysler (FCA US LLC)","component":"BACK OVER PREVENTION: SENSING SYSTEM: CAMERA","summary":"Chrysler (FCA US LLC) is recalling certain 2020 Jeep Gladiator and Jeep Cherokee, 2019-2020 Ram 1500 Pickup, Ram 2500 Pickup, Ram 3500 Pickup, Chrysler Pacifica, Dodge Durango, Jeep Grand Cherokee, Jeep Wrangler, and Jeep Renegade and 2019 Dodge Challenger vehicles equipped with 8.4\" or 12\" radio displays.  A software error can cause the rearview camera image to remain displayed after the vehicle has been shifted out of reverse.  As such, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard (FMVSS) number 111, \"Rearview Mirrors.\"","consequence":"The lingering rearview image can distract the driver, increasing the risk of a crash.","remedy":"Chrysler has notified owners, and dealers will update the radio display software, free of charge.  Optionally, owners can choose to remotely update their software via an Over-The-Air (OTA) update available as of May 1, 2020.  The recall began April 27, 2020.  Owners may contact Chrysler customer service at 1-800-853-1403.  Chrysler's number for this recall is W30-W37.","park_it":false,"park_outside":false,"over_the_air":true,"has_potential_units":true,"potential_units":319610,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V191000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":19,"campaign_vehicles":[{"year":"2020","make":"JEEP","model":"CHEROKEE"},{"year":"2020","make":"CHRYSLER","model":"PACIFICA"},{"year":"2020","make":"DODGE","model":"DURANGO"},{"year":"2020","make":"JEEP","model":"GRAND CHEROKEE"},{"year":"2020","make":"JEEP","model":"RENEGADE"},{"year":"2019","make":"DODGE","model":"DURANGO"},{"year":"2019","make":"CHRYSLER","model":"PACIFICA"},{"year":"2019","make":"DODGE","model":"CHALLENGER"},{"year":"2019","make":"JEEP","model":"WRANGLER"},{"year":"2020","make":"RAM","model":"1500"},{"year":"2019","make":"JEEP","model":"RENEGADE"},{"year":"2020","make":"RAM","model":"2500"},{"year":"2020","make":"RAM","model":"3500"},{"year":"2019","make":"JEEP","model":"GRAND CHEROKEE"},{"year":"2019","make":"RAM","model":"1500"},{"year":"2020","make":"JEEP","model":"GLADIATOR"},{"year":"2020","make":"JEEP","model":"WRANGLER"},{"year":"2019","make":"RAM","model":"2500"},{"year":"2019","make":"RAM","model":"3500"}],"campaign_vehicles_truncated":false},{"campaign":"19V637000","received":"2019-08-29","manufacturer":"Chrysler (FCA US LLC)","component":"STEERING:RACK AND PINION:RACK","summary":"Chrysler (FCA US LLC) is recalling certain 2019-2020 Jeep Cherokee vehicles.  The steering rack gear may break, possibly causing a loss of steering control.","consequence":"A loss of steering control increases the risk of a crash.","remedy":"Chrysler will notify owners, and dealers will replace the steering gear, free of charge.  The recall began October 24, 2019.  Owners may contact Chrysler customer service at 1-800-853-1403.  Chrysler's number for this recall is V99.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":5294,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=19V637000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2019","make":"JEEP","model":"CHEROKEE"},{"year":"2020","make":"JEEP","model":"CHEROKEE"}],"campaign_vehicles_truncated":false},{"campaign":"26V290000","received":"2026-05-07","manufacturer":"Chrysler (FCA US, LLC)","component":"POWER TRAIN","summary":"Chrysler (FCA US LLC) is recalling certain 2019-2023 Jeep Cherokee vehicles. The power transfer unit (PTU) may fail.","consequence":"A failed PTU may result in a loss of drive power or vehicle rollaway, increasing the risk of a crash or injury.","remedy":"Dealers will update the Drivetrain Control Drivetrain Control Module, PTU, and Electronic Park Brake software, and replace the PTU, as necessary, free of charge. Interim owner notification letters explaining the safety risk were mailed June 25, 2026. Additional letters will be sent once the final remedy becomes available. Owners may contact FCA customer service at 1-800-853-1403. FCA's number for this recall is 40D. Vehicle Identification Numbers (VINs) involved in this recall will become searchable on NHTSA.gov beginning May 14, 2026.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":61711,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=26V290000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":5,"campaign_vehicles":[{"year":"2020","make":"JEEP","model":"CHEROKEE"},{"year":"2023","make":"JEEP","model":"CHEROKEE"},{"year":"2019","make":"JEEP","model":"CHEROKEE"},{"year":"2021","make":"JEEP","model":"CHEROKEE"},{"year":"2022","make":"JEEP","model":"CHEROKEE"}],"campaign_vehicles_truncated":false}]}

aignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2019","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2019","make":"JEEP","model":"COMPASS"},{"year":"2018","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2018","make":"DODGE","model":"JOURNEY"},{"year":"2019","make":"JEEP","model":"CHEROKEE"},{"year":"2018","make":"JEEP","model":"COMPASS"}],"campaign_vehicles_truncated":false},{"campaign":"25V876000","received":"2025-12-18","manufacturer":"Rollx Vans","component":"EQUIPMENT ADAPTIVE/MOBILITY:WHEELCHAIR RESTRAINTS/SECUREMENT:LATCH/ANCHOR:","summary":"Rollx Vans (Rollx) is recalling certain GMC Yukon, Sierra, Chevrolet Express 2500, Ford Transit, E-250, Toyota Sienna, Sienna Hybrid, Honda Odyssey, Chrysler Town and Country, Voyager, Pacifica, Dodge Grand Caravan, and Ram Promaster vehicles equipped with QRT-Deluxe and QRT-Max wheelchair restraints. Please refer to Rollx's recall report for specific model year information. The retractors may not lock, preventing the wheelchair from being properly secured.","consequence":"An unsecured wheelchair can move during transit, increasing the risk of injury.","remedy":"Rollx will work with Q'Straint to inspect and replace the retractors as necessary, free of charge. Owner notification letters were mailed February 5, 2026. Owners may contact Rollx's customer service at 1-800-956-6668.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":86,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=25V876000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":52,"campaign_vehicles":[{"year":"2024","make":"TOYOTA","model":"SIENNA HYBRID"},{"year":"2023","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"CHRYSLER","model":"PACIFICA"},{"year":"2024","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"RAM","model":"PROMASTER"},{"year":"2024","make":"FORD","model":"TRANSIT"
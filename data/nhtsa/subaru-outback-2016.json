l_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2017","make":"SUBARU","model":"OUTBACK"},{"year":"2016","make":"SUBARU","model":"OUTBACK"}],"campaign_vehicles_truncated":false},{"campaign":"16V292000","received":"2016-05-11","manufacturer":"Subaru of America, Inc.","component":"STEERING:COLUMN","summary":"Subaru of America, Inc. (Subaru) is recalling certain model year 2016-2017 Legacy and Outback vehicles manufactured February 29, 2016, to May 6, 2016.  The steering column on the affected vehicles may have been improperly machined, and as a result, turning the steering wheel may have no effect on the direction of the wheels.","consequence":"The loss of steering ability would increase the risk of a crash.","remedy":"Subaru will notify owners, and dealers will inspect the lot number on the steering column, replacing the steering column, as necessary, free of charge.  The recall began May 13, 2016.  Owners may contact Subaru customer service at 1-800-782-2783 or by visiting http://www.wtd65.service-campaign.com.  Subaru's number for this recall is WTD-65.  Note: Until the vehicles have been inspected, owners are advised not to drive their vehicles.","park_it":true,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":48819,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=16V292000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":5,"campaign_vehicles":[{"year":"2015","make":"SUBARU","model":"OUTBACK"},{"year":"2017","make":"SUBARU","model":"LEGACY"},{"year":"2017","make":"SUBARU","model":"OUTBACK"},{"year":"2016","make":"SUBARU","model":"LEGACY"},{"year":"2016","make":"SUBARU","model":"OUTBACK"}],"campaign_vehicles_truncated":false},{"campaign":"15V502000","received":"2015-08-10","manufacturer":"Subaru of America, Inc.","component":"POWER TRAIN:DRIVELINE:DRIVESHAFT","summary":"Subaru of America, Inc. (Subaru) is recalling certain 2015 and 2016 model year Subaru Legacy 4-Door and Outback vehicles manufactured July 3, 2015, to July 27, 2015.  Transmission oil may leak from a deformed seal cap on the propeller shaft yoke.","consequence":"If the transmission oil leaks onto the exhaust pipe, there is a possible risk of fire.","remedy":"Subaru will notify owners, and dealers will replace the propeller shaft, free of charge. The recall began on August 28, 2015. Owners may contact 1-800-782-2783. Subaru's number for this recall is WQU-56.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":2893,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=15V502000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":4,"campaign_vehicles":[{"year":"2015","make":"SUBARU","model":"OUTBACK"},{"year":"2015","make":"SUBARU","model":"LEGACY"},{"year":"2016","make":"SUBARU","model":"LEGACY"},{"year":"2016","make":"SUBARU","model":"OUTBACK"}],"campaign_vehicles_truncated":false},{"campaign":"15V794000","received":"2015-11-24","manufacturer":"Subaru of America, Inc.","component":"POWER TRAIN:DRIVELINE:DRIVESHAFT","summary":"Subaru of America, Inc. (Subaru) is recalling certain model year 2016 Legacy vehicles manufactured October 24, 2015, to November 16, 2015, and Outback vehicles manufactured October 24, 2015, to November 17, 2015.  Due to the improper tightening of the securing nuts, the drive shaft may separate from the rear differential.","consequence":"If the drive shaft detaches from the rear differential, it may strike the fuel tank and result in a fuel leak, increasing the risk of a fire.","remedy":"Subaru has notified owners, and dealers will inspect the fastening nuts, and tighten or replace them, as necessary, free of charge. The recall began on December 10, 2015.  Owners may contact Subaru customer service at 1-856-488-8500.  Subaru's number for this recall is WQV-57.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":3251,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=15V794000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2016","make":"SUBARU","model":"LEGACY"},{"year":"2016","make":"SUBARU","model":"OUTBACK"}],"campaign_vehicles_truncated":false}]}

 will inspect and, if necessary, realign or replace the weld nuts, free of charge.  Owner notification letters were mailed on May 24, 2021.  Owners may contact Buick customer service at 1-800-521-7300, Chevrolet customer service at 1-800-222-1020, and GMC customer service at 1-800-462-8782.  GM's number for this recall is N202321200.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":108,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=21V246000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":23,"campaign_vehicles":[{"year":"2010","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2010","make":"BUICK","model":"ENCLAVE"},{"year":"2011","make":"BUICK","model":"ENCLAVE"},{"year":"2012","make":"BUICK","model":"ENCLAVE"},{"year":"2011","make":"GMC","model":"ACADIA"},{"year":"2011","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2014","make":"BUICK","model":"ENCLAVE"},{"year":"2015","make":"BUICK","model":"ENCLAVE"},{"year":"2017","make":"BUICK","model":"ENCLAVE"},{"year":"2019","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2014","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2014","make":"GMC","model":"ACADIA"},{"year":"2016","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2016","make":"GMC","model":"ACADIA"},{"year":"2017","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2015","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2015","make":"GMC","model":"ACADIA"},{"year":"2013","make":"GMC","model":"ACADIA"},{"year":"2013","make":"BUICK","model":"ENCLAVE"},{"year":"2013","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2012","make":"CHEVROLET","model":"TRAVERSE"},{"year":"2012","make":"GMC","model":"ACADIA"},{"year":"2018","make":"CHEVROLET","model":"TRAVERSE"}],"campaign_vehicles_truncated":false}]}

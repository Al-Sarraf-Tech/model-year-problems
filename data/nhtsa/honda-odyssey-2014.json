014-05-05","SERVICE BRAKES",0,0,0,0],[10586076,"2014-05-02","STRUCTURE,VISIBILITY/WIPER",0,0,0,0],[10583903,"2014-04-21","ELECTRICAL SYSTEM",0,0,0,0],[10583734,"2014-04-20","POWER TRAIN",0,0,0,0],[10575527,"2014-03-29","POWER TRAIN,ENGINE",0,0,0,0],[10574907,"2014-03-26","ENGINE",0,0,0,0],[10575006,"2014-03-26","SERVICE BRAKES",0,0,0,0],[10559712,"2014-01-13","POWER TRAIN",0,0,0,0],[10553792,"2013-11-25","VEHICLE SPEED CONTROL,SERVICE BRAKES",0,0,0,0],[10550022,"2013-10-29","POWER TRAIN",0,0,0,0],[10526244,"2013-07-22","VISIBILITY/WIPER",0,0,0,0]],"recalls":[{"campaign":"18V170000","received":"2018-03-13","manufacturer":"Honda (American Honda Motor Co.)","component":"SEATS:MID/REAR ASSEMBLY","summary":"Honda (American Honda Motor Co.) is recalling certain 2014-2016 Honda Odyssey vehicles.  The second row outboard seats have a lever to fold the seatback and slide the seat forward to access the third row seats.  Due to a manufacturing error, if the walk-in release lever is used to fold a fully reclined left outboard seatback forward, the seatback may stay in the unlocked position (free-folding) or unexpectedly unlock without engaging the walk-in or recliner lever.","consequence":"An unlocked second row left outboard seatback increases the risk of injury to the seat occupant during a crash.","remedy":"Honda will notify owners, and dealers will confirm proper operation of the second row left outboard seatback, and install a support bracket to the seat recliner.  If the seatback cannot lock, dealers will replace the seatback frame assembly.  These repairs will be performed free of charge.  The recall began May 7, 2018.  Owners may contact Honda customer service at 1-888-234-2138.  Honda's number for this recall is X0R.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":254568,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V170000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":3,"campaign_vehicles":[{"year":"2014","make":"HONDA","model":"ODYSSEY"},{"year":"2015","make":"HONDA","model":"ODYSSEY"},{"year":"2016","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"17V725000","received":"2017-11-17","manufacturer":"Honda (American Honda Motor Co.)","component":"SEATS:MID/REAR ASSEMBLY","summary":"Honda (American Honda Motor Co.) is recalling certain 2011-2017 Honda Odyssey vehicles.  The second row outboard seats can slide sideways to one of two positions.  If a seat is placed between either of the two positions when attaching the seat to the vehicle floor, the seat will not latch properly to the seat striker, allowing the seat to tip forward unexpectedly during braking.","consequence":"If the seat tips forward during braking, it can increase the risk of injury.","remedy":"Honda will notify owners, and dealers will install a bracket to the second row outboard floor strikers, free of charge.  The recall began April 2, 2018.  Owners may contact American Honda Customer Support & Campaign Center at 1-888-234-2138.  Honda's number for this recall is S0G.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":806936,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=17V725000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":7,"campaign_vehicles":[{"year":"2012","make":"HONDA","model":"ODYSSEY"},{"year":"2011","make":"HONDA","model":"ODYSSEY"},{"year":"2013","make":"HONDA","model":"ODYSSEY"},{"year":"2014","make":"HONDA","model":"ODYSSEY"},{"year":"2015","make":"HONDA","model":"ODYSSEY"},{"year":"2016","make":"HONDA","model":"ODYSSEY"},{"year":"2017","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"16V933000","received":"2016-12-27","manufacturer":"Honda (American Honda Motor Co.)","component":"SEATS:MID/REAR ASSEMBLY","summary":"Honda (American Honda Motor Co.) is recalling certain model year 2011-2016 Odyssey vehicles manufactured August 17, 2010, to October 1, 2015.  The affected vehicles have second row outboard seats that have a release lever that allows the seats to move for easier access to the third row of seats.  This release lever may remain in the unlocked position allowing the seats to move unexpectedly.","consequence":"An unlocked second row outboard seat increases the risk of injury to the seat occupant during a crash.","remedy":"Honda will notify owners, and dealers will install an additional bracket and spring to both second row outboard seats, free of charge.  Interim letter has been mailed, and a second notification will be sent . Owners may contact Honda customer service at 1-888-234-2138.  Honda's number for this recall is KD5.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":633753,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=16V933000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2012","make":"HONDA","model":"ODYSSEY"},{"year":"2011","make":"HONDA","model":"ODYSSEY"},{"year":"2013","make":"HONDA","model":"ODYSSEY"},{"year":"2014","make":"HONDA","model":"ODYSSEY"},{"year":"2015","make":"HONDA","model":"ODYSSEY"},{"year":"2016","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"14V175000","received":"2014-04-07","manufacturer":"Honda (American Honda Motor Co.)","component":"AIR BAGS:SIDE/WINDOW","summary":"Honda is recalling certain model year 2014 Odyssey vehicles manufactured October 2, 2013, through December 16, 2013.  The shorting terminal, an electrical connector used to prevent air bag deployment before being installed into a vehicle, may have been damaged during assembly of the passenger-side side curtain air bag.","consequence":"If the shorting terminal is damaged, the passenger-side side curtain air bag may fail to deploy thereby increasing the risk of occupant injury in a crash.","remedy":"Honda will notify owners, and dealers will replace the damaged shorting pin with a new shorting coupler, free of charge.  The recall began on  May 16, 2014.  Owners may contact Honda at 1-800-999-1009.  Honda's number for this recall is JE2.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":24889,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=14V175000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2014","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"23V858000","received":"2023-12-19","manufacturer":"Honda (American Honda Motor Co.)","component":"FUEL SYSTEM, GASOLINE:DELIVERY:FUEL PUMP","summary":"Honda (American Honda Motor Co.) is recalling certain 2013-2023 Honda Accord, Civic Coupe, Civic Sedan, Civic Hatchback, Civic Type R, CR-V, HR-V, Ridgeline, Odyssey, Acura ILX, MDX, MDX Hybrid, RDX, RLX, TLX, 2019-2022 Honda Insight, Passport, 2020 Honda CR-V Hybrid, 2018-2019 Honda Clarity PHEV, Fit, and 2015-2020 Honda Accord Hybrid, Pilot, Acura NSX vehicles.  The fuel pump inside the fuel tank may fail.","consequence":"Fuel pump failure can cause an engine stall while driving, increasing the risk of a crash.","remedy":"Dealers will replace the fuel pump module, free of charge.  Owner letters were mailed September 6, 2024.  Owners may contact Honda customer service at 1-888-234-2138.  Honda's numbers for this recall are KGC and KGD.  This recall is an expansion of NHTSA recall numbers 21V-215 and 20V-314.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":2490460,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V858000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":107,"campaign_vehicles":[{"year":"2020","make":"ACURA","model":"RDX"},{"year":"2020","make":"ACURA","model":"TLX"},{"year":"2020","make":"HONDA","model":"INSIGHT"},{"year":"2020","make":"ACURA","model":"RLX"},{"year":"2020","make":"ACURA","model":"MDX"},{"year":"2020","make":"HONDA","model":"HR-V"},{"year":"2018","make":"ACURA","model":"ILX"},{"year":"2018","make":"ACURA","model":"RLX"},{"year":"2018","make":"HONDA","model":"CR-V"},{"year":"2018","make":"ACURA","model":"NSX"},{"year":"2019","make":"ACURA","model":"TLX"},{"year":"2019","make":"HONDA","model":"RIDGELINE"},{"year":"2019","make":"ACURA","model":"RDX"},{"year":"2020","make":"HONDA","model":"PASSPORT"},{"year":"2019","make":"HONDA","model":"FIT"},{"year":"2019","make":"HONDA","model":"INSIGHT"},{"year":"2019","make":"HONDA","model":"ODYSSEY"},{"year":"2019","make":"HONDA","model":"HR-V"},{"year":"2019","make":"ACURA","model":"MDX"},{"year":"2019","make":"ACURA","model":"RLX"},{"year":"2019","make":"HONDA","model":"PASSPORT"},{"year":"2019","make":"ACURA","model":"ILX"},{"year":"2019","make":"ACURA","model":"NSX"},{"year":"2019","make":"HONDA","model":"ACCORD"}],"campaign_vehicles_truncated":true}]}

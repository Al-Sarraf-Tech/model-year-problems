[11206141,"2019-05-07","STEERING",0,0,0,0],[11197162,"2019-04-18","SEAT BELTS",0,0,0,0],[11181734,"2019-02-21","EXTERIOR LIGHTING",0,0,0,0],[11180092,"2019-02-14","UNKNOWN OR OTHER",0,0,0,0],[11165785,"2019-01-04","UNKNOWN OR OTHER",0,0,0,0],[11151101,"2018-11-12","EXTERIOR LIGHTING",0,0,0,0],[11142824,"2018-10-26","UNKNOWN OR OTHER",0,0,0,0],[11131724,"2018-09-26","SEAT BELTS",0,0,0,0],[11122157,"2018-08-24","POWER TRAIN,ENGINE",0,0,0,0],[11111999,"2018-07-17","EXTERIOR LIGHTING",0,0,0,0]],"recalls":[{"campaign":"22V703000","received":"2022-09-19","manufacturer":"Kia America, Inc.","component":"TRAILER HITCHES","summary":"Kia America, Inc. (Kia) is recalling certain 2016-2022 Sorento, 2021-2022 Sorento Hybrid (HEV), 2022-2023 Sorento Plug-In Hybrid (PHEV), and 2017-2022 Sportage vehicles equipped with a tow hitch harness installed as original equipment, or purchased as an accessory through a Kia dealership.  Debris and moisture accumulation on the tow hitch harness module printed circuit board (PCB) may cause an electrical short, which can result in a fire.","consequence":"A fire while parked or driving can increase the risk of injury.","remedy":"Owners are advised to park outside and away from structures until the recall repair is complete.  Dealers will inspect the vehicle, and, as necessary, replace the fuse and/or tow hitch harness module, free of charge.  Owner notification letters were mailed August 11, 2023.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC249.","park_it":false,"park_outside":true,"over_the_air":false,"has_potential_units":true,"potential_units":70887,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=22V703000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":18,"campaign_vehicles":[{"year":"2016","make":"KIA","model":"SORENTO"},{"year":"2017","make":"KIA","model":"SPORTAGE"},{"year":"2017","make":"KIA","model":"SORENTO"},{"year":"2021","make":"KIA","model":"SORENTO"},{"year":"2022","make":"KIA","model":"SORENTO PHEV"},{"year":"2022","make":"KIA","model":"SORENTO"},{"year":"2022","make":"KIA","model":"SORENTO HYBRID"},{"year":"2020","make":"KIA","model":"SORENTO"},{"year":"2018","make":"KIA","model":"SORENTO"},{"year":"2022","make":"KIA","model":"SPORTAGE"},{"year":"2021","make":"KIA","model":"SORENTO HYBRID"},{"year":"2019","make":"KIA","model":"SPORTAGE"},{"year":"2020","make":"KIA","model":"SPORTAGE"},{"year":"2019","make":"KIA","model":"SORENTO"},{"year":"2023","make":"KIA","model":"SORENTO PHEV"},{"year":"2023","make":"KIA","model":"SORENTO HYBRID"},{"year":"2018","make":"KIA","model":"SPORTAGE"},{"year":"2021","make":"KIA","model":"SPORTAGE"}],"campaign_vehicles_truncated":false},{"campaign":"23V639000","received":"2023-09-16","manufacturer":"Kia America, Inc.","component":"BACK OVER PREVENTION: SENSING SYSTEM: CAMERA","summary":"Kia America, Inc. (Kia) is recalling certain 2019 Sorento vehicles.  Due to a manufacturing error, water may leak into the rearview camera, which can cause the rearview camera image not to appear on the display.  As such, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard number 111, \"Rear Visibility.\"","consequence":"A rearview camera that does not display an image can reduce the driver's rear view, increasing the risk of a crash.","remedy":"Dealers will inspect the rearview camera and add additional water proofing to the camera harness, or replace the camera as necessary, free of charge.  Owner notification letters were mailed March 8, 2024.  Owners may contact Kia customer service at 1-800-333-4542.  Kia's number for this recall is SC282.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":83667,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V639000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2019","make":"KIA","model":"SORENTO"}],"campaign_vehicles_truncated":false}]}

ace both side curtain air bags, free of charge.  Owner notification letters were mailed beginning February 20, 2025.  Owners may contact FCA US, LLC customer service at 1-800-853-1403.  FCA US, LLC's number for this recall is 19B.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":284982,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=24V198000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":8,"campaign_vehicles":[{"year":"2018","make":"CHRYSLER","model":"300"},{"year":"2018","make":"DODGE","model":"CHARGER"},{"year":"2019","make":"DODGE","model":"CHARGER"},{"year":"2021","make":"CHRYSLER","model":"300"},{"year":"2020","make":"DODGE","model":"CHARGER"},{"year":"2021","make":"DODGE","model":"CHARGER"},{"year":"2020","make":"CHRYSLER","model":"300"},{"year":"2019","make":"CHRYSLER","model":"300"}],"campaign_vehicles_truncated":false}]}

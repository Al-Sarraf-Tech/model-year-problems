01","VISIBILITY/WIPER",0,0,0,0],[10818339,"2016-01-06","SEATS",0,0,0,0],[10817269,"2015-12-31","ELECTRICAL SYSTEM,EXTERIOR LIGHTING",0,0,0,0],[10795130,"2015-11-20","STRUCTURE",0,0,0,0],[10794721,"2015-11-18","ELECTRICAL SYSTEM",0,0,0,0],[10780034,"2015-10-06","VISIBILITY/WIPER",0,0,0,0],[10779449,"2015-10-03","STRUCTURE",0,0,0,0],[10761816,"2015-09-05","SERVICE BRAKES,ENGINE",0,0,0,0],[10760209,"2015-08-30","ELECTRICAL SYSTEM",0,0,0,0],[10749014,"2015-08-16","UNKNOWN OR OTHER",0,0,0,0],[10745363,"2015-07-31","SERVICE BRAKES",0,0,0,0],[10735150,"2015-07-20","UNKNOWN OR OTHER",0,0,0,0],[10706552,"2015-04-19","ELECTRICAL SYSTEM,ENGINE",0,0,0,0]],"recalls":[{"campaign":"19V410000","received":"2019-06-04","manufacturer":"Braun Corporation","component":"SERVICE BRAKES, HYDRAULIC:FOUNDATION COMPONENTS:HOSES, LINES/PIPING, AND FITTINGS","summary":"Braun Corporation (Braun) is recalling certain 2014-2019 Toyota Sienna mobility van conversions.  The brake lines may have incorrect tube nut fittings installed, which may cause a pressure drop within the braking system.","consequence":"The reduction in the braking system pressure may cause a loss of braking power in the rear braking system, increasing the risk of crash.","remedy":"Braun has notified owners, and dealers will install an adaptor to correct the issue, free of charge.  The recall began June 25, 2019.  Owners may contact Braun customer service at 1-800-488-0359.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":705,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=19V410000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2014","make":"TOYOTA","model":"SIENNA"},{"year":"2015","make":"TOYOTA","model":"SIENNA"},{"year":"2017","make":"TOYOTA","model":"SIENNA"},{"year":"2016","make":"TOYOTA","model":"SIENNA"},{"year":"2019","make":"TOYOTA","model":"SIENNA"},{"year":"2018","make":"TOYOTA","model":"SIENNA"}],"campaign_vehicles_truncated":false},{"campaign":"19V553000","received":"2019-07-25","manufacturer":"Vantage Mobility International, LLC","component":"SERVICE BRAKES, HYDRAULIC:FOUNDATION COMPONENTS:HOSES, LINES/PIPING, AND FITTINGS","summary":"Vantage Mobility International, LLC (Vantage) is recalling certain 2012-2018 AMS Genesis wheelchair vans, built on a Toyota Sienna vehicles.  The rubber brake hoses that attach to the rear wheel assembly may be too short, causing them to rub against the rear axle trailing arm.","consequence":"The contact may cause failure of the rear brake hoses, resulting in a loss of vehicle control and reduced braking ability, increasing the risk of a crash.","remedy":"Vantage will notify owners, and dealers will install a set of rear brake hoses that will provide the proper clearance, free of charge.  The recall began December 16, 2019.  Owners may contact Vantage customer service at 1-800-488-9082.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":303,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=19V553000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":7,"campaign_vehicles":[{"year":"2012","make":"TOYOTA","model":"SIENNA"},{"year":"2013","make":"TOYOTA","model":"SIENNA"},{"year":"2014","make":"TOYOTA","model":"SIENNA"},{"year":"2015","make":"TOYOTA","model":"SIENNA"},{"year":"2017","make":"TOYOTA","model":"SIENNA"},{"year":"2016","make":"TOYOTA","model":"SIENNA"},{"year":"2018","make":"TOYOTA","model":"SIENNA"}],"campaign_vehicles_truncated":false},{"campaign":"16V858000","received":"2016-11-29","manufacturer":"Toyota Motor Engineering & Manufacturing","component":"STRUCTURE:BODY:DOOR","summary":"Toyota Motor Engineering & Manufacturing (Toyota) is recalling certain model year 2011-2016 Toyota Sienna minivans manufactured January 4, 2010, to August 12, 2016.  If the power sliding door is unable to be opened when commanded, such as if the door is frozen shut, the door may subsequently open unexpectedly, possibly while the vehicle is moving.","consequence":"If door opens while the vehicle is moving, there would be an increased risk of injury to the vehicle occupants.","remedy":"Toyota will notify owners, and dealers will replace the junction block, rear sliding door wire harnesses, and install two sub wire harnesses, free of charge.  The recall began on July 28, 2017.  Owners may contact Toyota customer service at 1-800-331-4331.  Toyota's number for this recall is G04.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":744437,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=16V858000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2012","make":"TOYOTA","model":"SIENNA"},{"year":"2011","make":"TOYOTA","model":"SIENNA"},{"year":"2013","make":"TOYOTA","model":"SIENNA"},{"year":"2014","make":"TOYOTA","model":"SIENNA"},{"year":"2015","make":"TOYOTA","model":"SIENNA"},{"year":"2016","make":"TOYOTA","model":"SIENNA"}],"campaign_vehicles_truncated":false},{"campaign":"14V757000","received":"2014-11-26","manufacturer":"Toyota Motor Engineering & Manufacturing","component":"AIR BAGS:SIDE/WINDOW","summary":"Toyota Motor Engineering & Manufacturing (Toyota) is recalling certain model year 2015 Sienna vehicles manufactured September 2, 2014, to November 25, 2014.  In the event of a crash that necessitates the deployment of the curtain shield airbag (CSA), the second row overhead assist grips may detach.","consequence":"If the assist grip detaches due to CSA deployment, the grip may strike a vehicle occupant, increasing the risk of injury.","remedy":"Toyota will notify owners, and dealers will modify the headliner near the second row overhead assist grip, free of charge.  The recall began on January 15, 2015.  Owners may contact Toyota customer service at 1-800-331-4331.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":25551,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=14V757000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2015","make":"TOYOTA","model":"SIENNA"}],"campaign_vehicles_truncated":false},{"campaign":"15V236000","received":"2015-04-21","manufacturer":"Southeast Toyota Distributors, LLC","component":"STRUCTURE:BODY:ROOF AND PILLARS","summary":"Southeast Toyota Distributors, LLC (SET) is recalling certain model year 2015 Sienna vehicles manufactured September 1, 2014, to April 13, 2015 and equipped with overhead entertainment accessories installed by SET.  During reassembly of the interior after the overhead entertainment system installation, a trim panel securing clip may have been reused instead of being replaced.","consequence":"If the clip was damaged during the entertainment system installation, in the event of a side curtain air bag deployment, the trim panel may detach and strike one of the vehicle occupants, increasing the risk of injury.","remedy":"SET will notify owners, and dealers will replace the trim panel securing clip, free of charge.  The recall began on May 22, 2015.  Owners may contact SET customer service at 1-866-405-4226.  SET's number for this recall is SET15B.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":262,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=15V236000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2015","make":"TOYOTA","model":"SIENNA"}],"campaign_vehicles_truncated":false},{"campaign":"15V240000","received":"
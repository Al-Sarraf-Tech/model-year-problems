,0,0,0,0],[10595021,"2014-05-30","ELECTRICAL SYSTEM",0,0,0,0]],"recalls":[{"campaign":"19V149000","received":"2019-02-28","manufacturer":"Subaru of America, Inc.","component":"EXTERIOR LIGHTING:BRAKE LIGHTS:SWITCH","summary":"Subaru of America, Inc. (Subaru) is recalling certain 2014-2016 Forester, 2008-2016 Impreza sedans, 2012-2016 Impreza station wagons, 2008-2014 WRX sedans (including STI), and 2013-2017 Crosstrek vehicles.  Exposure to certain contaminants may cause the brake light switch to malfunction, preventing the brake lights from illuminating and also preventing keyless ignition vehicles from starting and CVT/automatic transmissions from being able to be shifted out of Park.","consequence":"Brake lights that do not illuminate properly will not alert other drivers that the vehicle is slowing or stopping, increasing the risk of crash.","remedy":"Subaru will notify owners, and dealers will replace the brake light switch, free of charge.  The recall began April 15, 2019.  Owners may contact Subaru customer service at 1-844-373-6614.  Subaru's number for this recall is WUE-90.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":1303530,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=19V149000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":24,"campaign_vehicles":[{"year":"2008","make":"SUBARU","model":"IMPREZA"},{"year":"2009","make":"SUBARU","model":"IMPREZA"},{"year":"2010","make":"SUBARU","model":"IMPREZA"},{"year":"2012","make":"SUBARU","model":"IMPREZA"},{"year":"2009","make":"SUBARU","model":"WRX"},{"year":"2013","make":"SUBARU","model":"IMPREZA"},{"year":"2011","make":"SUBARU","model":"IMPREZA"},{"year":"2008","make":"SUBARU","model":"WRX"},{"year":"2014","make":"SUBARU","model":"FORESTER"},{"year":"2014","make":"SUBARU","model":"IMPREZA"},{"year":"2011","make":"SUBARU","model":"WRX"},{"year":"2015","make":"SUBARU","model":"FORESTER"},{"year":"2014","make":"SUBARU","model":"WRX"},{"year":"2016","make":"SUBARU","model":"IMPREZA"},{"year":"2010","make":"SUBARU","model":"WRX"},{"year":"2012","make":"SUBARU","model":"WRX"},{"year":"2013","make":"SUBARU","model":"WRX"},{"year":"2015","make":"SUBARU","model":"IMPREZA"},{"year":"2016","make":"SUBARU","model":"CROSSTREK"},{"year":"2013","make":"SUBARU","model":"CROSSTREK"},{"year":"2016","make":"SUBARU","model":"FORESTER"},{"year":"2017","make":"SUBARU","model":"CROSSTREK"},{"year":"2015","make":"SUBARU","model":"CROSSTREK"},{"year":"2014","make":"SUBARU","model":"CROSSTREK"}],"campaign_vehicles_truncated":false},{"campaign":"19V701000","received":"2019-10-03","manufacturer":"Subaru of America, Inc.","component":"AIR BAGS:SENSOR:OCCUPANT CLASSIFICATION","summary":"Subaru of America, Inc. (Subaru) is recalling certain 2015-2018 Forester vehicles equipped with heated seats.  An electrical connection in the front passenger seat for the Occupant Detection System (ODS) may loosen.","consequence":"If the connection loosens, the front passenger airbag may deactivate even though the seat is occupied, increasing the risk of injury to the front passenger in the event of a crash.","remedy":"Subaru will notify owners, and dealers will inspect and, as necessary, replace the ODS sensor mat harness, free of charge.  The recall began February 11, 2020.  Owners may contact Subaru customer service at 1-844-373-6614.  Subaru's number for this recall is WUM-98.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":366282,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=19V701000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":4,"campaign_vehicles":[{"year":"2015","make":"SUBARU","model":"FORESTER"},{"year":"2017","make":"SUBARU","model":"FORESTER"},{"year":"2016","make":"SUBARU","model":"FORESTER"},{"year":"2018","make":"SUBARU","model":"FORESTER"}],"campaign_vehicles_truncated":false},{"campaign":"16V162000","received":"2016-03-21","manufacturer":"Subaru of America, Inc.","component":"ENGINE AND ENGINE COOLING:ENGINE:GASOLINE:TURBO/SUPERCHARGER","summary":"Subaru of America, Inc. (Subaru) is recalling certain model year 2015-2016 WRX vehicles manufactured April 10, 2015, to October 21, 2015, and Forester 2.0XT vehicles manufactured April 10, 2015, to October 20, 2015.  The turbocharger air intake duct may crack and possibly result in an engine stall.","consequence":"An engine stall increases the risk of a crash.","remedy":"Subaru will notify owners, and dealers will inspect the turbocharger air intake duct, and replace it as necessary, free of charge, depending on the lot number found on the duct.  The recall began April 2016.  Owners may contact Subaru customer service at 1-800-782-2783.  Subaru's number for this recall is WTA-62.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":18187,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=16V162000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":4,"campaign_vehicles":[{"year":"2015","make":"SUBARU","model":"FORESTER"},{"year":"2016","make":"SUBARU","model":"WRX"},{"year":"2015","make":"SUBARU","model":"WRX"},{"year":"2016","make":"SUBARU","model":"FORESTER"}],"campaign_vehicles_truncated":false}]}

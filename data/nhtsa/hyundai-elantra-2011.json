YSTEM",0,0,0,0],[10417315,"2011-07-31","VEHICLE SPEED CONTROL",0,0,0,0],[10410967,"2011-07-07","TIRES",0,0,0,0],[10411079,"2011-07-06","TIRES",0,0,0,0],[10410752,"2011-07-06","ELECTRONIC STABILITY CONTROL (ESC),TRACTION CONTROL SYSTEM",0,0,0,0],[10410290,"2011-07-02","UNKNOWN OR OTHER",0,0,0,0],[10410207,"2011-07-01","STEERING",0,0,0,0],[10408839,"2011-06-24","SUSPENSION",0,0,0,0],[10409488,"2011-06-21","ENGINE AND ENGINE COOLING",0,0,0,0],[10407234,"2011-06-17","POWER TRAIN",0,0,0,0],[10402144,"2011-05-20","ENGINE AND ENGINE COOLING",0,0,0,0],[10402112,"2011-05-19","POWER TRAIN",0,0,0,0],[10401991,"2011-05-18","WHEELS",0,0,0,0],[10399995,"2011-05-11","STEERING,SERVICE BRAKES, HYDRAULIC",0,0,0,0],[10400064,"2011-05-11","SEAT BELTS",0,0,0,0],[10401689,"2011-05-11","SERVICE BRAKES, HYDRAULIC",0,0,0,0],[10399081,"2011-05-04","EQUIPMENT",0,0,0,0],[10396681,"2011-04-18","TIRES",0,0,0,0]],"recalls":[{"campaign":"15V629000","received":"2015-10-07","manufacturer":"Hyundai Motor America","component":"SUSPENSION:FRONT:SPRINGS:COIL SPRINGS","summary":"Hyundai Motor America (Hyundai) is recalling certain model year 2011 Elantra vehicles manufactured November 12, 2010, to March 31, 2011, and Sonata vehicles manufactured December 11, 2009, to February 28, 2010, originally sold in, or currently registered in, Connecticut, Delaware, Illinois, Indiana, Iowa, Maine, Maryland, Massachusetts, Michigan, Minnesota, Missouri, New Hampshire, New Jersey, New York, Ohio, Pennsylvania, Rhode Island, Vermont, West Virginia, Wisconsin and the District of Columbia.  Road salt may corrode the front coil springs, possibly resulting in the coil springs fracturing.","consequence":"If a front coil spring fractures, it may contact the tire, possibly puncturing it, increasing the risk of a crash.","remedy":"Hyundai will notify owners, and dealers will replace the front coil springs, free of charge.  Interim notifications were mailed on November 17, 2015.  The recall began on January 6, 2016.  Owners may contact Hyundai customer service at 1-855-671-3059.  Hyundai's number for this recall is 133.  Note: Vehicles that were previously registered in salt belt states but are currently registered elsewhere are eligible to be inspected and repaired.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":28157,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=15V629000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2011","make":"HYUNDAI","model":"ELANTRA"},{"year":"2011","make":"HYUNDAI","model":"SONATA"}],"campaign_vehicles_truncated":false},{"campaign":"15V871000","received":"2015-12-23","manufacturer":"Hyundai Motor America","component":"ELECTRONIC STABILITY CONTROL (ESC)","summary":"Hyundai Motor America (Hyundai) is recalling certain model year 2011-2012 Elantra vehicles manufactured October 29, 2010, to October 25, 2011.  Due to an electronic stability control (ESC) sensor malfunction, the brakes for one or more wheels may be applied unexpectedly and the engine power may be reduced.  These symptoms will be accompanied by illumination of the ESC indicator lamp in the instrument cluster.","consequence":"If the one or more of the brakes are inappropriately applied, control of the vehicle may be lost, increasing the risk of a crash.","remedy":"Hyundai will notify owners, and dealers will verify the proper operation of the ESC sensors, and update the ESC system's calibration, free of charge.  The recall began June 6, 2016.  Owners may contact Hyundai customer service at 1-800-633-5151.  Hyundai's number for this recall is 137.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":155000,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=15V871000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2011","make":"HYUNDAI","model":"ELANTRA"},{"year":"2012","make":"HYUNDAI","model":"ELANTRA"}],"campaign_vehicles_truncated":false},{"campaign":"13V115000","received":"2013-04-01","manufacturer":"Hyundai Motor Company","component":"AIR BAGS:SIDE/WINDOW","summary":"Hyundai Motor Company is recalling certain model year 2011-2013 Elantra vehicles manufactured from November 12, 2010, through March 5, 2013.  A support bracket attached to the headliner may become displaced during a side curtain airbag deployment.","consequence":"If the headliner support bracket makes contact with an occupant during a crash, it may cause a laceration injury.","remedy":"Hyundai will notify owners, and dealers will apply adhesive strips to the headliner, free of charge.  The safety recall began during April 2013.  Owners may contact Hyundai at 1-800-633-5151.  Hyundai's recall campaign number is 109.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":186250,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=13V115000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":3,"campaign_vehicles":[{"year":"2011","make":"HYUNDAI","model":"ELANTRA"},{"year":"2012","make":"HYUNDAI","model":"ELANTRA"},{"year":"2013","make":"HYUNDAI","model":"ELANTRA"}],"campaign_vehicles_truncated":false},{"campaign":"20V393000","received":"2020-07-02","manufacturer":"Hyundai Motor America","component":"EQUIPMENT:ELECTRICAL","summary":"Hyundai Motor America (Hyundai) is recalling certain 2011-2012 Hyundai Elantra and Sonata Hybrid, 2012 Accent and Veloster vehicles.  The 12V accessory socket outlet may have been over-tightened during installation, possibly disabling the thermal fuse and allowing the outlet to overheat with prolonged use, such as by using the Tire Mobility Kit air compressor to inflate a tire.","consequence":"An overheated accessory outlet increases the risk of fire.","remedy":"Hyundai will notify owners, and dealers will replace the Tire Mobility Kit accessory outlet plug with a direct-to-battery connection wire harness kit, free of charge.  The recall began September 28, 2020.  Owners may contact Hyundai customer service at 1-855-371-9460.  Hyundai's number for this recall is 193.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":272126,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V393000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2012","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2011","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2012","make":"HYUNDAI","model":"VELOSTER"},{"year":"2011","make":"HYUNDAI","model":"ELANTRA"},{"year":"2012","make":"HYUNDAI","model":"ACCENT"},{"year":"2012","make":"HYUNDAI","model":"ELANTRA"}],"campaign_vehicles_truncated":false},{"campaign":"23V651000","received":"2023-09-22","manufacturer":"Hyundai Motor America","component":"SERVICE BRAKES, HYDRAULIC:ANTILOCK/TRACTION CONTROL/ELECTRONIC LIMITED SLIP:CONTROL UNIT/MODULE","summary":"Hyundai Motor America (Hyundai) is recalling certain 2011-2015 Elantra, Genesis Coupe, Sonata Hybrid, 2012-2015 Accent, Azera, Veloster, 2013-2015 Elantra Coupe, Santa Fe, 2014-2015 Equus, 2010-2012 Veracruz, 2010-2013 Tucson, 2015 Tucson Fuel Cell, and 2013 Santa Fe Sport vehicles.  The Anti-Lock Brake System (ABS) module may leak brake fluid internally and cause an electrical short, which can result in an engine compartment fire while parked or driving.","consequence":"An engine compartment fire while parked or driving can increase the risk of injury.","remedy":"Owners are advised to park outside and away from structures until the recall repair is complete.  Dealers will replace the ABS fuse, free of charge.  Owner notification letters were mailed April 10, 2024 through October 11, 2024.   Owners may contact Hyundai customer service at 1-855-371-9460.  Hyundai's number for this recall is 251.","park_it":false,"park_outside":true,"over_the_air":false,"has_potential_units":true,"potential_units":1649478,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V651000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":44,"campaign_vehicles":[{"year":"2014","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2014","make":"HYUNDAI","model":"VELOSTER"},{"year":"2014","make":"HYUNDAI","model":"AZERA"},{"year":"2013","make":"HYUNDAI","model":"ELANTRA"},{"year":"2012","make":"HYUNDAI","model":"TUCSON"},{"year":"2012","make":"HYUNDAI","model":"GENESIS COUPE"},{"year":"2015","make":"HYUNDAI","model":"VELOSTER"},{"year":"2013","make":"HYUNDAI","model":"ACCENT"},{"year":"2014","make":"HYUNDAI","model":"ELANTRA COUPE"},{"year":"2011","make":"HYUNDAI","model":"GENESIS COUPE"},{"year":"2013","make":"HYUNDAI","model":"ELANTRA COUPE"},{"year":"2011","make":"HYUNDAI","model":"TUCSON"},{"year":"2015","make":"HYUNDAI","model":"ELANTRA"},{"year":"2011","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2014","make":"HYUNDAI","model":"EQUUS"},{"year":"2015","make":"HYUNDAI","model":"ACCENT"},{"year":"2013","make":"HYUNDAI","model":"GENESIS COUPE"},{"year":"2015","make":"HYUNDAI","model":"SANTA FE"},{"year":"2015","make":"HYUNDAI","model":"GENESIS COUPE"},{"year":"2012","make":"HYUNDAI","model":"VERACRUZ"},{"year":"2015","make":"HYUNDAI","model":"AZERA"},{"year":"2013","make":"HYUNDAI","model":"SANTA FE SPORT"},{"year":"2015","make":"HYUNDAI","model":"ELANTRA COUPE"},{"year":"2010","make":"HYUNDAI","model":"VERACRUZ"}],"campaign_vehicles_truncated":true}]}

ential_units":true,"potential_units":186588,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=24V146000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2015","make":"HYUNDAI","model":"ELANTRA"},{"year":"2016","make":"HYUNDAI","model":"ELANTRA"}],"campaign_vehicles_truncated":false},{"campaign":"26V307000","received":"2026-05-15","manufacturer":"Hyundai Motor America","component":"AIR BAGS:FRONTAL:DRIVER SIDE:INFLATOR MODULE","summary":"Hyundai Motor America (Hyundai) is recalling certain 2015-2016 Elantra and 2016 Elantra GT vehicles. The driver's air bag inflator may rupture during deployment.","consequence":"An air bag inflator that ruptures may result in sharp metal fragments striking the driver or passengers, increasing the risk of injury or death.","remedy":"Dealers will inspect and replace the air bag inflator, as necessary, free of charge. Interim notification letters, notifying owners of the safety risk, were mailed July 3, 2026. Additional letters will be sent once the final remedy is available, anticipated August, 2026.\nOwners may contact Hyundai customer service at 1-855-371-9460. Hyundai's number for this recall is 300. Vehicle Identification Numbers (VINs) involved in this recall became searchable on NHTSA.gov on May 16, 2026.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":3493,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=26V307000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":3,"campaign_vehicles":[{"year":"2015","make":"HYUNDAI","model":"ELANTRA"},{"year":"2016","make":"HYUNDAI","model":"ELANTRA"},{"year":"2016","make":"HYUNDAI","model":"ELANTRA GT"}],"campaign_vehicles_truncated":false}]}

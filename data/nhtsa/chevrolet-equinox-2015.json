EM",0,0,0,0],[10916671,"2016-10-17","ELECTRICAL SYSTEM",0,0,0,0],[10906347,"2016-09-14","VISIBILITY/WIPER",0,0,0,0],[10906099,"2016-09-13","STEERING,ELECTRICAL SYSTEM,ELECTRONIC STABILITY CONTROL (ESC)",0,0,0,0],[10870314,"2016-05-23","STEERING",0,0,0,0],[10861769,"2016-04-27","VEHICLE SPEED CONTROL",1,0,0,0],[10859875,"2016-04-16","VEHICLE SPEED CONTROL",0,0,0,0],[10851476,"2016-03-24","UNKNOWN OR OTHER",0,0,0,0],[10850926,"2016-03-22","ELECTRICAL SYSTEM",0,0,0,0],[10840320,"2016-03-07","ELECTRICAL SYSTEM,SERVICE BRAKES",0,0,0,0],[10823193,"2016-01-29","UNKNOWN OR OTHER",0,0,0,0],[10822386,"2016-01-26","ELECTRICAL SYSTEM,WHEELS,ELECTRONIC STABILITY CONTROL (ESC)",0,0,0,0],[10819485,"2016-01-11","UNKNOWN OR OTHER",1,0,1,0],[10811523,"2015-12-21","AIR BAGS",1,0,2,0],[10807574,"2015-11-30","UNKNOWN OR OTHER,SERVICE BRAKES",0,0,0,0],[10807092,"2015-11-26","AIR BAGS",1,0,1,0],[10794460,"2015-11-17","VISIBILITY/WIPER",0,0,0,0],[10783254,"2015-10-19","SERVICE BRAKES",0,0,0,0],[10779169,"2015-10-01","ELECTRICAL SYSTEM",0,0,0,0],[10762444,"2015-09-09","ELECTRICAL SYSTEM",0,0,0,0],[10748368,"2015-08-13","STEERING,ELECTRICAL SYSTEM,ENGINE",0,0,0,0],[10747692,"2015-08-10","UNKNOWN OR OTHER",0,0,0,0],[10733749,"2015-07-13","ELECTRICAL SYSTEM,SERVICE BRAKES",0,0,0,0]],"recalls":[{"campaign":"15V666000","received":"2015-10-16","manufacturer":"General Motors LLC","component":"AIR BAGS:SIDE/WINDOW","summary":"General Motors LLC (GM) is recalling certain model year 2015 Buick LaCrosse, Cadillac XTS, Chevrolet Camaro, Equinox, Malibu, and GMC Terrain vehicles.  The affected vehicles have front seat-mounted side impact air bags whose inflator may rupture upon its deployment.","consequence":"In the event of a crash necessitating deployment of one or both of the side impact air bags, the air bag's inflator may rupture and the air bag may not properly inflate. The rupture could cause metal fragments to strike the vehicle occupants, potentially resulting in serious injury or death.  Additionally, if the air bag does not properly inflate, the driver or passenger is at an increased risk of injury.","remedy":"GM will notify owners, and dealers will replace the side impact air bag modules, free of charge. The recall began on October 19, 2015.  Owners may contact Buick customer service at 1-800-521-7300, Chevrolet customer service at 1-800-222-1020, Cadillac customer service at 1-800-458-8006, or GMC customer service at 1-800-462-8782.  GM's number for this recall is 01320.","park_it":false,"park_outside":false,"over_the_air":false},{"campaign":"22V165000","received":"2022-03-17","manufacturer":"General Motors, LLC","component":"VISIBILITY:WINDSHIELD WIPER/WASHER:MOTOR","summary":"General Motors, LLC (GM) is recalling certain 2014-2015 Chevrolet Equinox and GMC Terrain vehicles.  The ball joints in the windshield wiper module may corrode, causing one or both windshield wipers to fail.","consequence":"Inoperative windshield wipers can reduce visibility in certain driving conditions, increasing the risk of a crash.","remedy":"Dealers will inspect the wiper module, and repair or replace it as necessary, free of charge.  Interim owner notification letters informing owners of the safety risk were mailed on April 21, 2022.  Owner notification letters were mailed on October 25, 2022.  Owners may contact Chevrolet customer service at 1-800-222-1020 and GMC customer service at 1-800-462-8782.  GM's number for this recall is N212352530.","park_it":false,"park_outside":false,"over_the_air":false}]}

lse},{"campaign":"21V749000","received":"2021-09-24","manufacturer":"Hyundai Motor America","component":"EXTERIOR LIGHTING:TURN SIGNAL","summary":"Hyundai Motor America (Hyundai) is recalling certain 2015-2017 Sonata, 2016-2017 Sonata Hybrid, and Sonata Plug-In Hybrid vehicles.  The Smart Junction Box (SJB) software logic may not properly interpret the signals received from the multifunction switch, which could cause the turn signal to activate in the opposite direction of what the driver intended.","consequence":"A turn signal that activates in the opposite direction of what was intended by the driver increases the risk of a crash.","remedy":"Dealers will update the SJB software, free of charge.  Owner notification letters were mailed November 19, 2021.  Owners may contact Hyundai customer service at 1-855-371-9460.  Hyundai's number for this recall is 210.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":469377,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=21V749000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":7,"campaign_vehicles":[{"year":"2016","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2017","make":"HYUNDAI","model":"SONATA PLUG-IN HYBRID"},{"year":"2017","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2015","make":"HYUNDAI","model":"SONATA"},{"year":"2016","make":"HYUNDAI","model":"SONATA PLUG-IN HYBRID"},{"year":"2016","make":"HYUNDAI","model":"SONATA"},{"year":"2017","make":"HYUNDAI","model":"SONATA"}],"campaign_vehicles_truncated":false},{"campaign":"21V619000","received":"2021-08-06","manufacturer":"Hyundai Motor America","component":"LATCHES/LOCKS/LINKAGES:TRUNK LID:LATCH","summary":"Hyundai Motor America (Hyundai) is recalling certain 2017-2018 Sonata, 2016-2018 Sonata Hybrid, 2018-2020 Accent, and 2016-2017 Azera vehicles.  The trunk latch may become damaged, preventing the opening of the trunk from the inside.  As such, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard number 401, \"Internal Trunk Release.\"","consequence":"A person inside the trunk compartment may become trapped, increasing their risk of injury.","remedy":"Dealers will replace the trunk latch base, free of charge.  Owner notification letters were mailed December 4, 2021.  Owners may contact Hyundai customer service at 1-855-371-9460.  Hyundai's number for this recall is 208.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":348158,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=21V619000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":10,"campaign_vehicles":[{"year":"2016","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2017","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2019","make":"HYUNDAI","model":"ACCENT"},{"year":"2018","make":"HYUNDAI","model":"SONATA HYBRID"},{"year":"2020","make":"HYUNDAI","model":"ACCENT"},{"year":"2016","make":"HYUNDAI","model":"AZERA"},{"year":"2018","make":"HYUNDAI","model":"SONATA"},{"year":"2018","make":"HYUNDAI","model":"ACCENT"},{"year":"2017","make":"HYUNDAI","model":"SONATA"},{"year":"2017","make":"HYUNDAI","model":"AZERA"}],"campaign_vehicles_truncated":false}]}

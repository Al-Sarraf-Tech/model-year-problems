ners that parts are not available yet were mailed on October 26, 2016.  The recall began on August 15, 2017.  Owners may contact Chrysler customer service at 1-800-853-1403.  Chrysler's number for this recall is S61.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":1435625,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=16V668000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":23,"campaign_vehicles":[{"year":"2010","make":"CHRYSLER","model":"SEBRING"},{"year":"2010","make":"DODGE","model":"AVENGER"},{"year":"2010","make":"DODGE","model":"CALIBER"},{"year":"2011","make":"JEEP","model":"COMPASS"},{"year":"2011","make":"DODGE","model":"AVENGER"},{"year":"2011","make":"CHRYSLER","model":"200"},{"year":"2012","make":"JEEP","model":"PATRIOT"},{"year":"2012","make":"CHRYSLER","model":"200"},{"year":"2011","make":"JEEP","model":"PATRIOT"},{"year":"2013","make":"JEEP","model":"PATRIOT"},{"year":"2010","make":"JEEP","model":"COMPASS"},{"year":"2012","make":"DODGE","model":"CALIBER"},{"year":"2011","make":"DODGE","model":"CALIBER"},{"year":"2012","make":"JEEP","model":"COMPASS"},{"year":"2013","make":"CHRYSLER","model":"200"},{"year":"2013","make":"JEEP","model":"COMPASS"},{"year":"2013","make":"DODGE","model":"AVENGER"},{"year":"2014","make":"JEEP","model":"PATRIOT"},{"year":"2010","make":"JEEP","model":"PATRIOT"},{"year":"2012","make":"DODGE","model":"AVENGER"},{"year":"2014","make":"JEEP","model":"COMPASS"},{"year":"2014","make":"DODGE","model":"AVENGER"},{"year":"2014","make":"CHRYSLER","model":"200"}],"campaign_vehicles_truncated":false}]}

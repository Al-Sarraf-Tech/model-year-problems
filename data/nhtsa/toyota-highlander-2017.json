 customer service at 1-800-255-3987.  Note: This recall is an expansion of recall 20V-012.  Toyota's number for this recall is 20TA02.  Lexus' number for this recall is 20LA01.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":1525742,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V682000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":65,"campaign_vehicles":[{"year":"2020","make":"TOYOTA","model":"SIENNA"},{"year":"2017","make":"LEXUS","model":"RX350"},{"year":"2019","make":"LEXUS","model":"GS300"},{"year":"2019","make":"LEXUS","model":"GS 350"},{"year":"2019","make":"LEXUS","model":"IS 350"},{"year":"2019","make":"LEXUS","model":"RX350"},{"year":"2019","make":"LEXUS","model":"RC 300"},{"year":"2019","make":"LEXUS","model":"RC 350"},{"year":"2019","make":"LEXUS","model":"IS 300"},{"year":"2019","make":"LEXUS","model":"LS500"},{"year":"2019","make":"LEXUS","model":"ES350"},{"year":"2019","make":"LEXUS","model":"LX570"},{"year":"2018","make":"LEXUS","model":"NX300"},{"year":"2019","make":"LEXUS","model":"NX300"},{"year":"2019","make":"LEXUS","model":"GX460"},{"year":"2018","make":"TOYOTA","model":"HIGHLANDER"},{"year":"2018","make":"TOYOTA","model":"SIENNA"},{"year":"2018","make":"TOYOTA","model":"TACOMA"},{"year":"2018","make":"LEXUS","model":"GS 350"},{"year":"2019","make":"TOYOTA","model":"AVALON"},{"year":"2019","make":"TOYOTA","model":"4RUNNER"},{"year":"2019","make":"TOYOTA","model":"CAMRY"},{"year":"2019","make":"TOYOTA","model":"HIGHLANDER"},{"year":"2019","make":"TOYOTA","model":"LAND CRUISER"}],"campaign_vehicles_truncated":true}]}

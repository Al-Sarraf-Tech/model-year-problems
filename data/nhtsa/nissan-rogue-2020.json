49,"2020-02-21","STRUCTURE",0,0,0,0],[11303063,"2020-01-30","ELECTRICAL SYSTEM,SERVICE BRAKES",0,0,0,0]],"recalls":[{"campaign":"23V093000","received":"2023-02-16","manufacturer":"Nissan North America, Inc.","component":"ELECTRICAL SYSTEM:IGNITION:ANTI-THEFT:IMMOBILIZER/PROXIMITY:KEY/SENDER","summary":"Nissan North America, Inc. (Nissan) is recalling certain 2014-2020 Rogue and 2017-2022 Rogue Sport vehicles equipped with a jackknife style ignition key.  The jackknife key may collapse into a folded position while driving.","consequence":"Driver contact with a key in the collapsed position could inadvertently shut off the vehicle while driving, increasing the risk of a crash.  Additionally, if the vehicle shuts off while driving, the air bags may not deploy in a crash as intended, increasing the risk of injury.","remedy":"Dealers will insert a spacer into the key slot of the jackknife key, free of charge.  Interim notification letters notifying owners of the safety risk were mailed March 29, 2023.  Owner notification letters are expected to be mailed August 30, 2023.  Owners may contact Nissan's customer service at 1-800-867-7669.  Nissan's number for this recall is R22C5.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":712458,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V093000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":13,"campaign_vehicles":[{"year":"2020","make":"NISSAN","model":"ROGUE"},{"year":"2019","make":"NISSAN","model":"ROGUE"},{"year":"2018","make":"NISSAN","model":"ROGUE"},{"year":"2016","make":"NISSAN","model":"ROGUE"},{"year":"2014","make":"NISSAN","model":"ROGUE"},{"year":"2017","make":"NISSAN","model":"ROGUE"},{"year":"2015","make":"NISSAN","model":"ROGUE"},{"year":"2020","make":"NISSAN","model":"ROGUE SPORT"},{"year":"2018","make":"NISSAN","model":"ROGUE SPORT"},{"year":"2019","make":"NISSAN","mode
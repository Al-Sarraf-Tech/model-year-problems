D CONTROL",0,0,0,0],[11151249,"2018-11-13","FUEL SYSTEM, GASOLINE,POWER TRAIN",0,0,0,0],[11144203,"2018-10-30","POWER TRAIN,AIR BAGS,WHEELS",1,0,0,0],[11133181,"2018-10-03","ELECTRICAL SYSTEM,UNKNOWN OR OTHER",0,0,0,0],[11115357,"2018-08-02","ELECTRICAL SYSTEM",0,0,0,0],[11104862,"2018-06-30","POWER TRAIN",0,0,0,0],[11103864,"2018-06-25","ELECTRICAL SYSTEM",0,1,0,0],[11099840,"2018-06-04","VEHICLE SPEED CONTROL",0,0,0,0],[11067356,"2018-02-06","ELECTRICAL SYSTEM,UNKNOWN OR OTHER,VISIBILITY/WIPER",0,0,0,0],[11063549,"2018-01-18","VEHICLE SPEED CONTROL,UNKNOWN OR OTHER,FUEL/PROPULSION SYSTEM",1,0,0,0],[11035843,"2017-10-23","ELECTRICAL SYSTEM,UNKNOWN OR OTHER,ENGINE",0,0,0,0],[11002680,"2017-07-02","STRUCTURE",0,0,0,0],[10978919,"2017-04-17","SEAT BELTS",0,0,0,0]],"recalls":[{"campaign":"18V524000","received":"2018-08-09","manufacturer":"Chrysler (FCA US LLC)","component":"ELECTRICAL SYSTEM:WIRING:FRONT UNDERHOOD","summary":"Chrysler (FCA US LLC) is recalling certain 2018 Jeep Renegade, Compass and Grand Cherokee, RAM 1500 and Promaster, Fiat 500x, Dodge Journey, Challenger, Charger and Durango and Chrysler 300x vehicles, 2017-2018 Jeep Wrangler, Dodge Grand Caravan and Chrysler Town and Country vehicles and 2018-2019 Jeep Cherokee and 2018 Chrysler Pacifica and Pacifica Hybrid vehicles.  The powertrain control module may be equipped with a voltage regulator chip in the circuit board that may fail, causing a stall or a no start condition.","consequence":"A vehicle stall can increase the risk of a crash.","remedy":"Chrysler will notify owners, and dealers will replace the powertrain control module, free of charge.  The recall began October 2, 2018.  Owners may contact Chrysler customer service at 1-800-853-1403.  Chrysler's number for this recall is U87.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":12779,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V524000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":23,"campaign_vehicles":[{"year":"2017","make":"JEEP","model":"WRANGLER"},{"year":"2018","make":"FIAT","model":"500X"},{"year":"2018","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2019","make":"CHRYSLER","model":"PACIFICA"},{"year":"2018","make":"DODGE","model":"DURANGO"},{"year":"2018","make":"JEEP","model":"WRANGLER"},{"year":"2018","make":"CHRYSLER","model":"PACIFICA"},{"year":"2018","make":"JEEP","model":"CHEROKEE"},{"year":"2017","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2017","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2018","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2018","make":"DODGE","model":"CHALLENGER"},{"year":"2018","make":"DODGE","model":"JOURNEY"},{"year":"2019","make":"JEEP","model":"CHEROKEE"},{"year":"2018","make":"CHRYSLER","model":"300"},{"year":"2018","make":"JEEP","model":"RENEGADE"},{"year":"2018","make":"RAM","model":"PROMASTER"},{"year":"2018","make":"JEEP","model":"COMPASS"},{"year":"2018","make":"JEEP","model":"GRAND CHEROKEE"},{"year":"2018","make":"DODGE","model":"CHARGER"},{"year":"2018","make":"RAM","model":"1500"},{"year":"2018","make":"CHRYSLER","model":"PACIFICA PLUG-IN HYBRID"},{"year":"2017","make":"CHRYSLER","model":"PACIFICA"}],"campaign_vehicles_truncated":false},{"campaign":"20V278000","received":"2020-05-15","manufacturer":"Vantage Mobility International, LLC","component":"FUEL SYSTEM, GASOLINE:STORAGE:TANK ASSEMBLY","summary":"Vantage Mobility International, LLC  (Vantage) is recalling certain Vantage-modified 2016-2019 Dodge Grand Caravan vehicles.  The fuel pump gasket may deteriorate, allowing fuel to leak.","consequence":"A fuel leak in the presence of an ignition source can increase the risk of a fire.","remedy":"Vantage will notify owners, and will provide parts and reimbursement to owners for repair facilities to replace the fuel tank gasket, free of charge.  The recall began May 19, 2020.  Owners may contact Vantage customer service at 1-800-488-9082.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":122,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=20V278000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":4,"campaign_vehicles":[{"year":"2018","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2019","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2016","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2017","make":"DODGE","model":"GRAND CARAVAN"}],"campaign_vehicles_truncated":false},{"campaign":"25V876000","received":"2025-12-18","manufacturer":"Rollx Vans","component":"EQUIPMENT ADAPTIVE/MOBILITY:WHEELCHAIR RESTRAINTS/SECUREMENT:LATCH/ANCHOR:","summary":"Rollx Vans (Rollx) is recalling certain GMC Yukon, Sierra, Chevrolet Express 2500, Ford Transit, E-250, Toyota Sienna, Sienna Hybrid, Honda Odyssey, Chrysler Town and Country, Voyager, Pacifica, Dodge Grand Caravan, and Ram Promaster vehicles equipped with QRT-Deluxe and QRT-Max wheelchair restraints. Please refer to Rollx's recall report for specific model year information. The retractors may not lock, preventing the wheelchair from being properly secured.","consequence":"An unsecured wheelchair can move during transit, increasing the risk of injury.","remedy":"Rollx will work with Q'Straint to inspect and replace the retractors as necessary, free of charge. Owner notification letters were mailed February 5, 2026. Owners may contact Rollx's customer service at 1-800-956-6668.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":86,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=25V876000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":52,"campaign_vehicles":[{"year":"2024","make":"TOYOTA","model":"SIENNA HYBRID"},{"year":"2023","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"CHRYSLER","model":"PACIFICA"},{"year":"2024","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"RAM","model":"PROMASTER"},{"year":"2024","make":"FORD","model":"TRANSIT"},{"year":"2025","make":"TOYOTA","model":"SIENNA HYBRID"},{"year":"2025","make":"CHRYSLER","model":"PACIFICA"},{"year":"2025","make":"RAM","model":"PROMASTER"},{"year":"2025","make":"CHRYSLER","model":"VOYAGER"},{"year":"2025","make":"GMC","model":"YUKON"},{"year":"2025","make":"GMC","model":"SIERRA 1500"},{"year":"2025","make":"FORD","model":"TRANSIT"},{"year":"2021","make":"CHRYSLER","model":"PACIFICA"},{"year":"2010","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2011","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2012","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2013","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2014","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2015","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2019","make":"FORD","model":"TRANSIT"},{"year":"2019","make":"RAM","model":"PROMASTER"},{"year":"2011","make":"FORD","model":"E-250"},{"year":"2011","make":"DODGE","model":"GRAND CARAVAN"}],"campaign_vehicles_truncated":true}]}

 AND TIGHTEN THEM TO THE PROPER TORQUE SPECIFICATION FREE OF CHARGE.  THE SAFETY RECALL BEGAN ON AUGUST 8, 2011.  OWNERS MAY CONTACT NISSAN AT 1-800-647-7261.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":20000,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=11V371000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2012","make":"NISSAN","model":"ALTIMA"},{"year":"2011","make":"NISSAN","model":"ALTIMA"}],"campaign_vehicles_truncated":false}]}

BRAKES",0,0,0,0],[10681865,"2015-02-07","STRUCTURE,EQUIPMENT ADAPTIVE/MOBILITY",0,0,0,0],[10668292,"2014-12-26","ELECTRICAL SYSTEM,ENGINE",0,0,0,0]],"recalls":[{"campaign":"17V425000","received":"2017-07-03","manufacturer":"Southeast Toyota Distributors, LLC","component":"STRUCTURE:BODY:HOOD:HINGE AND ATTACHMENTS","summary":"Southeast Toyota Distributors, LLC (SET) is recalling certain 2011-2016 Toyota Tacoma and 4Runner vehicles equipped with accessory hood scoops installed by SET or SET dealers.  The adhesive attaching the hood scoop may weaken, allowing the hood scoop to detach from the vehicle.","consequence":"If the hood scoop detaches, it may become a road hazard, increasing the risk of a crash.","remedy":"SET will notify owners, and dealers will mechanically fasten the scoop to the hood, free of charge.  The recall began on September 1, 2017.  Owners may contact SET customer service at 1-954-429-2000.  SET's number for this recall is SET17B.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":3547,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=17V425000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":12,"campaign_vehicles":[{"year":"2012","make":"TOYOTA","model":"TACOMA"},{"year":"2011","make":"TOYOTA","model":"4RUNNER"},{"year":"2011","make":"TOYOTA","model":"TACOMA"},{"year":"2012","make":"TOYOTA","model":"4RUNNER"},{"year":"2013","make":"TOYOTA","model":"TACOMA"},{"year":"2014","make":"TOYOTA","model":"TACOMA"},{"year":"2014","make":"TOYOTA","model":"4RUNNER"},{"year":"2015","make":"TOYOTA","model":"4RUNNER"},{"year":"2015","make":"TOYOTA","model":"TACOMA"},{"year":"2013","make":"TOYOTA","model":"4RUNNER"},{"year":"2016","make":"TOYOTA","model":"TACOMA"},{"year":"2016","make":"TOYOTA","model":"4RUNNER"}],"campaign_vehicles_truncated":false},{"campaign":"14V828000","received":"2014-12-30","manufacturer":"Southeast Toyota Distributors, LLC","component":"EQUIPMENT","summary":"Southeast Toyota Distributors, LLC (SET) is recalling certain model year 2014-2015 Toyota 4Runner, Tacoma, FJ Cruiser, Land Cruiser, RAV4, Scion FRS, and XB vehicles.  The affected vehicles may have accessories installed by SET, such as running boards or other items, that were incorrectly installed.  The accessory attaching fasteners were not tightened with the proper torque, possibly causing the accessory to detach from the vehicle.","consequence":"Accessories that detach from a vehicle may result in a vehicle crash and/or personal injury.","remedy":"SET will notify owners, and dealers will inspect and tighten the affected bolts, free of charge. The recall began February 23, 2015. Owners may contact SET customer service at 1-866-405-4226. SET's number for this recall is SET-14B.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":3958,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=14V828000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":14,"campaign_vehicles":[{"year":"2014","make":"TOYOTA","model":"TACOMA"},{"year":"2014","make":"TOYOTA","model":"FJ CRUISER"},{"year":"2014","make":"TOYOTA","model":"LAND CRUISER"},{"year":"2014","make":"TOYOTA","model":"RAV4"},{"year":"2014","make":"TOYOTA","model":"4RUNNER"},{"year":"2015","make":"TOYOTA","model":"LAND CRUISER"},{"year":"2015","make":"TOYOTA","model":"RAV4"},{"year":"2014","make":"SCION","model":"XB"},{"year":"2015","make":"SCION","model":"XB"},{"year":"2014","make":"SCION","model":"FR-S"},{"year":"2015","make":"TOYOTA","model":"4RUNNER"},{"year":"2015","make":"TOYOTA","model":"FJ CRUISER"},{"year":"2015","make":"SCION","model":"FR-S"},{"year":"2015","make":"TOYOTA","model":"TACOMA"}],"campaign_vehicles_truncated":false},{"campaign":"15V099000","received":"2015-02-23","manufacturer":"Toyota Motor Engineering & Manufacturing","component":"TIRES","summary":"Toyota Motor Engineering & Manufacturing (Toyota) is recalling certain model year 2015 Tacoma pickup trucks manufactured August 7, 2014, to December 22, 2014. The affected vehicles may have had their tires and wheels changed to TRD PRO accessory tires and wheels, causing the inflation information on the tire placard to be incorrect which may result in the tire being improperly inflated. As such, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard (FMVSS) No. 110, \"Tire Selection and Rims and Motor Home/Recreation Vehicle Trailer Load Carrying Capacity Information for Motor Vehicles with a GVWR of 4,536 kilograms (10,000 pounds) or less.\"","consequence":"Improperly inflated tires may increase the risk of a vehicle crash.","remedy":"Toyota will notify owners, and dealers will send a revised tire placard with correct tire size and inflation information to owners, free of charge. The recall began March 13, 2015.  Owners may contact Toyota customer service at 1-800-331-4331.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":18,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=15V099000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2015","make":"TOYOTA","model":"TACOMA"}],"campaign_vehicles_truncated":false},{"campaign":"14V663000","received":"2014-10-22","manufacturer":"Gulf States Toyota, Inc.","component":"EQUIPMENT:OTHER:LABELS","summary":"Gulf States Toyota, Inc. (Gulf States) is recalling certain model year 2015 Toyota Tacoma vehicles manufactured September 2, 2014, to October 15, 2014.  The affected vehicles may contain an incorrect Load Carrying Capacity Modification Label.  As a result, these vehicles fail to comply with the requirements of Federal Motor Vehicle Safety Standard No. 110, \"Tire Selection and Rims for Passenger Cars.\"","consequence":"An incorrect label may result in the vehicle being overloaded, increasing the risk of a crash.","remedy":"Gulf States has notified owners, and dealers will install an accurate label, free of charge.  The recall began December 1, 2014.  Owners may contact Gulf States customer service at 1-800-444-1074.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":142,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=14V663000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":1,"campaign_vehicles":[{"year":"2015","make":"TOYOTA","model":"TACOMA"}],"campaign_vehicles_truncated":false}]}

"2013-10-08","AIR BAGS,SEAT BELTS",1,0,0,0],[10544544,"2013-09-20","AIR BAGS",1,0,0,0],[10544407,"2013-09-19","SEAT BELTS",0,0,0,0],[10537389,"2013-08-26","ELECTRICAL SYSTEM,AIR BAGS",0,0,0,0],[10535865,"2013-08-17","POWER TRAIN,VEHICLE SPEED CONTROL",0,0,0,0],[10534982,"2013-08-12","STRUCTURE",0,0,1,0],[10526312,"2013-07-23","AIR BAGS",0,0,0,0],[10487406,"2012-12-05","VEHICLE SPEED CONTROL",0,0,0,0]],"recalls":[{"campaign":"14V234000","received":"2014-05-07","manufacturer":"Chrysler Group LLC","component":"ELECTRICAL SYSTEM","summary":"Chrysler Group, LLC (Chrysler) is recalling certain model year 2010-2014 Chrysler Town and Country and Dodge Grand Caravan vehicles manufactured August 25, 2010, through October 31, 2013.  The affected vehicles may experience overheating of the vent window switch in the driver's door armrest.","consequence":"An overheated switch may result in a vehicle fire.","remedy":"Chrysler will notify owners, and dealers will replace the vent window switch with a newer version, free of charge.  The owner notification letter was issued and the remedy campaign launched on on December 31, 2014.  Owners may contact Chrysler customer service at 1-800-853-1403.  Chrysler's number for this recall is P25.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":644757,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=14V234000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":10,"campaign_vehicles":[{"year":"2010","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2012","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2012","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2011","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2013","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2010","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2014","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2013","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2011","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2014","make":"DODGE","model":"GRAND CARAVAN"}],"campaign_vehicles_truncated":false},{"campaign":"13V291000","received":"2013-07-02","manufacturer":"Chrysler Group LLC","component":"AIR BAGS","summary":"Chrysler is recalling certain model year 2013 Town & Country and Dodge Grand Caravan vehicles manufactured June 11, 2013, through June 12, 2013.  The occupant restraint control module (ORC) has incorrect software installed which may adversely affect air bag deployments in collisions.  Thus, these vehicles fail to conform to the requirements of Federal Motor Vehicle Safety Standard No. 208, \"Occupant Crash Protection\" and No. 214, \"Side Impact Protection.\"","consequence":"An air bag that does not deploy, or deploys improperly, may increase the risk of injury.","remedy":"Chrysler will notify owners, and dealers will replace the ORC module, free of charge.  The recall began on October 3, 2013.  Owners may contact Chrysler at 1-800-247-9753.  Chrysler's recall campaign number is N48.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":184,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=13V291000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":2,"campaign_vehicles":[{"year":"2013","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2013","make":"DODGE","model":"GRAND CARAVAN"}],"campaign_vehicles_truncated":false},{"campaign":"13V283000","received":"2013-07-02","manufacturer":"Chrysler Group LLC","component":"ELECTRICAL SYSTEM","summary":"Chrysler is recalling certain model year 2013 Town & Country, Dodge Grand Caravan, and RAM C/V Tradesman vehicles manufactured May 10, 2012, through June 7, 2013.  A software error may result in the opposite side airbags deploying from the collision point (a left side impact would deploy the right side airbags and vice versa).","consequence":"In the event of a crash, the wrong side airbags could deploy leaving the occupant with no airbag protection at the point of impact, increasing the risk of injury.","remedy":"Chrysler will notify owners, and dealers will flash the occupant restraint control module, free of charge.  The recall began during September 2013.  Owners may contact Chrysler at 1-800-247-9753.  Chrysler's recall campaign number is N44.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":224264,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=13V283000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":3,"campaign_vehicles":[{"year":"2013","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2013","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2013","make":"RAM","model":"C/V TRADESMAN"}],"campaign_vehicles_truncated":false},{"campaign":"25V876000","received":"2025-12-18","manufacturer":"Rollx Vans","component":"EQUIPMENT ADAPTIVE/MOBILITY:WHEELCHAIR RESTRAINTS/SECUREMENT:LATCH/ANCHOR:","summary":"Rollx Vans (Rollx) is recalling certain GMC Yukon, Sierra, Chevrolet Express 2500, Ford Transit, E-250, Toyota Sienna, Sienna Hybrid, Honda Odyssey, Chrysler Town and Country, Voyager, Pacifica, Dodge Grand Caravan, and Ram Promaster vehicles equipped with QRT-Deluxe and QRT-Max wheelchair restraints. Please refer to Rollx's recall report for specific model year information. The retractors may not lock, preventing the wheelchair from being properly secured.","consequence":"An unsecured wheelchair can move during transit, increasing the risk of injury.","remedy":"Rollx will work with Q'Straint to inspect and replace the retractors as necessary, free of charge. Owner notification letters were mailed February 5, 2026. Owners may contact Rollx's customer service at 1-800-956-6668.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":86,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=25V876000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":52,"campaign_vehicles":[{"year":"2024","make":"TOYOTA","model":"SIENNA HYBRID"},{"year":"2023","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"CHRYSLER","model":"PACIFICA"},{"year":"2024","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"RAM","model":"PROMASTER"},{"year":"2024","make":"FORD","model":"TRANSIT"},{"year":"2025","make":"TOYOTA","model":"SIENNA HYBRID"},{"year":"2025","make":"CHRYSLER","model":"PACIFICA"},{"year":"2025","make":"RAM","model":"PROMASTER"},{"year":"2025","make":"CHRYSLER","model":"VOYAGER"},{"year":"2025","make":"GMC","model":"YUKON"},{"year":"2025","make":"GMC","model":"SIERRA 1500"},{"year":"2025","make":"FORD","model":"TRANSIT"},{"year":"2021","make":"CHRYSLER","model":"PACIFICA"},{"year":"2010","make":"DODGE","model":"GRAND CARAVAN"},{"year":"2011","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2012","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2013","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2014","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2015","make":"CHRYSLER","model":"TOWN AND COUNTRY"},{"year":"2019","make":"FORD","model":"TRANSIT"},{"year":"2019","make":"RAM","model":"PROMASTER"},{"year":"2011","make":"FORD","model":"E-250"},{"year":"2011","make":"DODGE","model":"GRAND CARAVAN"}],"campaign_vehicles_truncated":true}]}

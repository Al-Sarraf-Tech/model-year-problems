LE SPEED CONTROL",0,0,0,0],[10761868,"2015-09-06","POWER TRAIN,ENGINE",0,0,0,0],[10745366,"2015-07-31","EXTERIOR LIGHTING",0,0,0,0],[10735673,"2015-07-22","POWER TRAIN",0,0,0,0],[10732222,"2015-07-06","ELECTRICAL SYSTEM,UNKNOWN OR OTHER,VISIBILITY/WIPER",0,0,0,0],[10727022,"2015-06-24","SUSPENSION",0,0,0,0],[10724237,"2015-06-09","UNKNOWN OR OTHER",0,0,0,0],[10723868,"2015-06-07","UNKNOWN OR OTHER",0,0,0,0],[10722796,"2015-06-01","TIRES",0,0,0,0],[10722273,"2015-05-29","ELECTRICAL SYSTEM",0,0,0,0],[10713668,"2015-04-29","POWER TRAIN",0,0,0,0],[10706607,"2015-04-20","SUSPENSION,ENGINE,FUEL/PROPULSION SYSTEM",0,0,0,0],[10703078,"2015-04-01","VISIBILITY",0,0,0,0],[10701264,"2015-03-23","ELECTRICAL SYSTEM,STRUCTURE",0,0,0,0],[10700732,"2015-03-20","ELECTRONIC STABILITY CONTROL (ESC)",0,0,0,0],[10694293,"2015-03-14","POWER TRAIN",0,0,0,0],[10689739,"2015-02-21","POWER TRAIN",0,0,0,0],[10681832,"2015-02-06","AIR BAGS",0,0,0,0],[10678816,"2015-01-26","ELECTRICAL SYSTEM,SERVICE BRAKES,ENGINE",0,0,1,0],[10664075,"2014-12-13","POWER TRAIN,ENGINE",0,0,0,0],[10648744,"2014-10-20","SERVICE BRAKES",0,0,0,0],[10633523,"2014-09-16","STEERING,ELECTRICAL SYSTEM,FUEL/PROPULSION SYSTEM",0,0,0,0],[10632917,"2014-09-13","AIR BAGS",0,0,0,0]],"recalls":[{"campaign":"18V170000","received":"2018-03-13","manufacturer":"Honda (American Honda Motor Co.)","component":"SEATS:MID/REAR ASSEMBLY","summary":"Honda (American Honda Motor Co.) is recalling certain 2014-2016 Honda Odyssey vehicles.  The second row outboard seats have a lever to fold the seatback and slide the seat forward to access the third row seats.  Due to a manufacturing error, if the walk-in release lever is used to fold a fully reclined left outboard seatback forward, the seatback may stay in the unlocked position (free-folding) or unexpectedly unlock without engaging the walk-in or recliner lever.","consequence":"An unlocked second row left outboard seatback increases the risk of injury to the seat occupant during a crash.","remedy":"Honda will notify owners, and dealers will confirm proper operation of the second row left outboard seatback, and install a support bracket to the seat recliner.  If the seatback cannot lock, dealers will replace the seatback frame assembly.  These repairs will be performed free of charge.  The recall began May 7, 2018.  Owners may contact Honda customer service at 1-888-234-2138.  Honda's number for this recall is X0R.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":254568,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=18V170000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":3,"campaign_vehicles":[{"year":"2014","make":"HONDA","model":"ODYSSEY"},{"year":"2015","make":"HONDA","model":"ODYSSEY"},{"year":"2016","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"17V725000","received":"2017-11-17","manufacturer":"Honda (American Honda Motor Co.)","component":"SEATS:MID/REAR ASSEMBLY","summary":"Honda (American Honda Motor Co.) is recalling certain 2011-2017 Honda Odyssey vehicles.  The second row outboard seats can slide sideways to one of two positions.  If a seat is placed between either of the two positions when attaching the seat to the vehicle floor, the seat will not latch properly to the seat striker, allowing the seat to tip forward unexpectedly during braking.","consequence":"If the seat tips forward during braking, it can increase the risk of injury.","remedy":"Honda will notify owners, and dealers will install a bracket to the second row outboard floor strikers, free of charge.  The recall began April 2, 2018.  Owners may contact American Honda Customer Support & Campaign Center at 1-888-234-2138.  Honda's number for this recall is S0G.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":806936,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=17V725000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":7,"campaign_vehicles":[{"year":"2012","make":"HONDA","model":"ODYSSEY"},{"year":"2011","make":"HONDA","model":"ODYSSEY"},{"year":"2013","make":"HONDA","model":"ODYSSEY"},{"year":"2014","make":"HONDA","model":"ODYSSEY"},{"year":"2015","make":"HONDA","model":"ODYSSEY"},{"year":"2016","make":"HONDA","model":"ODYSSEY"},{"year":"2017","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"16V933000","received":"2016-12-27","manufacturer":"Honda (American Honda Motor Co.)","component":"SEATS:MID/REAR ASSEMBLY","summary":"Honda (American Honda Motor Co.) is recalling certain model year 2011-2016 Odyssey vehicles manufactured August 17, 2010, to October 1, 2015.  The affected vehicles have second row outboard seats that have a release lever that allows the seats to move for easier access to the third row of seats.  This release lever may remain in the unlocked position allowing the seats to move unexpectedly.","consequence":"An unlocked second row outboard seat increases the risk of injury to the seat occupant during a crash.","remedy":"Honda will notify owners, and dealers will install an additional bracket and spring to both second row outboard seats, free of charge.  Interim letter has been mailed, and a second notification will be sent . Owners may contact Honda customer service at 1-888-234-2138.  Honda's number for this recall is KD5.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":633753,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=16V933000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":6,"campaign_vehicles":[{"year":"2012","make":"HONDA","model":"ODYSSEY"},{"year":"2011","make":"HONDA","model":"ODYSSEY"},{"year":"2013","make":"HONDA","model":"ODYSSEY"},{"year":"2014","make":"HONDA","model":"ODYSSEY"},{"year":"2015","make":"HONDA","model":"ODYSSEY"},{"year":"2016","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"16V417000","received":"2016-06-09","manufacturer":"Honda (American Honda Motor Co.)","component":"FUEL SYSTEM, GASOLINE:STORAGE:TANK ASSEMBLY","summary":"Honda (American Honda Motor Co.) is recalling certain model year 2015 Acura MDX 2WD and MDX 4WD vehicles, 2016 Acura MDX 4WD vehicles, 2015-2016 Honda Odyssey vehicles, and 2016 Honda Pilot 2WD and 4WD vehicles.  The affected vehicles have fuel tanks that were manufactured with insufficient welds which may separate and allow fuel to leak out.","consequence":"A fuel leak in the presence of an ignition source may result in a fire.","remedy":"Honda will notify owners, and dealers will replace the fuel tanks, free of charge.  Owners may contact Honda/Acura customer service at 1-888-234-2138.  The recall began on July 29, 2016.  Honda's numbers for this recall are KA9 (Honda vehicles) and KB0 (Acura vehicles).","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":39,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=16V417000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":5,"campaign_vehicles":[{"year":"2015","make":"ACURA","model":"MDX"},{"year":"2015","make":"HONDA","model":"ODYSSEY"},{"year":"2016","make":"HONDA","model":"PILOT"},{"year":"2016","make":"ACURA","model":"MDX"},{"year":"2016","make":"HONDA","model":"ODYSSEY"}],"campaign_vehicles_truncated":false},{"campaign":"23V858000","received":"2023-12-19","manufacturer":"Honda (American Honda Motor Co.)","component":"FUEL SYSTEM, GASOLINE:DELIVERY:FUEL PUMP","summary":"Honda (American Honda Motor Co.) is recalling certain 2013-2023 Honda Accord, Civic Coupe, Civic Sedan, Civic Hatchback, Civic Type R, CR-V, HR-V, Ridgeline, Odyssey, Acura ILX, MDX, MDX Hybrid, RDX, RLX, TLX, 2019-2022 Honda Insight, Passport, 2020 Honda CR-V Hybrid, 2018-2019 Honda Clarity PHEV, Fit, and 2015-2020 Honda Accord Hybrid, Pilot, Acura NSX vehicles.  The fuel pump inside the fuel tank may fail.","consequence":"Fuel pump failure can cause an engine stall while driving, increasing the risk of a crash.","remedy":"Dealers will replace the fuel pump module, free of charge.  Owner letters were mailed September 6, 2024.  Owners may contact Honda customer service at 1-888-234-2138.  Honda's numbers for this recall are KGC and KGD.  This recall is an expansion of NHTSA recall numbers 21V-215 and 20V-314.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":2490460,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=23V858000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":107,"campaign_vehicles":[{"year":"2020","make":"ACURA","model":"RDX"},{"year":"2020","make":"ACURA","model":"TLX"},{"year":"2020","make":"HONDA","model":"INSIGHT"},{"year":"2020","make":"ACURA","model":"RLX"},{"year":"2020","make":"ACURA","model":"MDX"},{"year":"2020","make":"HONDA","model":"HR-V"},{"year":"2018","make":"ACURA","model":"ILX"},{"year":"2018","make":"ACURA","model":"RLX"},{"year":"2018","make":"HONDA","model":"CR-V"},{"year":"2018","make":"ACURA","model":"NSX"},{"year":"2019","make":"ACURA","model":"TLX"},{"year":"2019","make":"HONDA","model":"RIDGELINE"},{"year":"2019","make":"ACURA","model":"RDX"},{"year":"2020","make":"HONDA","model":"PASSPORT"},{"year":"2019","make":"HONDA","model":"FIT"},{"year":"2019","make":"HONDA","model":"INSIGHT"},{"year":"2019","make":"HONDA","model":"ODYSSEY"},{"year":"2019","make":"HONDA","model":"HR-V"},{"year":"2019","make":"ACURA","model":"MDX"},{"year":"2019","make":"ACURA","model":"RLX"},{"year":"2019","make":"HONDA","model":"PASSPORT"},{"year":"2019","make":"ACURA","model":"ILX"},{"year":"2019","make":"ACURA","model":"NSX"},{"year":"2019","make":"HONDA","model":"ACCORD"}],"campaign_vehicles_truncated":true},{"campaign":"25V876000","received":"2025-12-18","manufacturer":"Rollx Vans","component":"EQUIPMENT ADAPTIVE/MOBILITY:WHEELCHAIR RESTRAINTS/SECUREMENT:LATCH/ANCHOR:","summary":"Rollx Vans (Rollx) is recalling certain GMC Yukon, Sierra, Chevrolet Express 2500, Ford Transit, E-250, Toyota Sienna, Sienna Hybrid, Honda Odyssey, Chrysler Town and Country, Voyager, Pacifica, Dodge Grand Caravan, and Ram Promaster vehicles equipped with QRT-Deluxe and QRT-Max wheelchair restraints. Please refer to Rollx's recall report for specific model year information. The retractors may not lock, preventing the wheelchair from being properly secured.","consequence":"An unsecured wheelchair can move during transit, increasing the risk of injury.","remedy":"Rollx will work with Q'Straint to inspect and replace the retractors as necessary, free of charge. Owner notification letters were mailed February 5, 2026. Owners may contact Rollx's customer service at 1-800-956-6668.","park_it":false,"park_outside":false,"over_the_air":false,"has_potential_units":true,"potential_units":86,"potential_units_source_url":"https://api.nhtsa.gov/recalls/campaignNumber?campaignNumber=25V876000","potential_units_source_title":"NHTSA Recalls API (campaignNumber)","campaign_vehicle_count":52,"campaign_vehicles":[{"year":"2024","make":"TOYOTA","model":"SIENNA HYBRID"},{"year":"2023","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"CHRYSLER","model":"PACIFICA"},{"year":"2024","make":"CHRYSLER","model":"VOYAGER"},{"year":"2024","make":"RAM","model":"PROMASTER"},{"year":"2024","make":"FORD","model":"TRANSIT"},{"year":"2025","make":"TOYOTA","model":"SIENNA HYBRID"},{"year":"2025","make":"CHRYSLER","model":"PACIFICA"},{"year":"2025","make":"RAM","model":"PROMASTER"},{"year":"2025","make":"CHRYSLER","model":"VOYAGER"},{"year":"2025","make":"GMC","model":"Y